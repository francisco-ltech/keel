#!/usr/bin/env bash
# Formats, then runs everything deterministic and fast: lint and both type
# checkers, about a second in total.
#
# The test suite is deliberately not here. It is 99% of the cost and the
# smallest share of the benefit — a type error is certain to fail CI, whereas
# tests you just ran are usually still passing. It runs on push instead. A hook
# slow enough to provoke `--no-verify` stops being enforced at all.
set -euo pipefail

command -v just >/dev/null 2>&1 || { echo "pre-commit: just not installed; skipping" >&2; exit 0; }

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

just fmt >/dev/null

# Re-stage only paths that were already staged. Formatting may also have touched
# files deliberately left out of this commit, and those stay out.
echo "$staged" | while IFS= read -r path; do
    [ -f "$path" ] && git add -- "$path"
done

just quick
