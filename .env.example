# Keel development configuration.
#
# No `KEEL_` prefix: these name your infrastructure, not the framework.
# `DATABASE_URL` and `REDIS_URL` are what hosting platforms and tooling already
# use. For a namespace, pass one: `DatabaseConfig.from_env(prefix="ACME_")`.
#
# Postgres is on 5433 and Redis on 6380, to avoid clashing with anything already
# running on the default ports.

DATABASE_URL=postgresql+asyncpg://keel:keel@localhost:5433/keel
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Seconds; `none` leaves the server default. A cap means one pathological query
# fails instead of starving the pool behind it.
DB_STATEMENT_TIMEOUT=30

REDIS_URL=redis://localhost:6380/0
CACHE_STORE=redis
CACHE_PREFIX=keel
CACHE_TTL=300
