"""The application factory and its wiring.

Three things are worth reading closely.

**Wiring is one lifespan.** ``database_lifespan``, ``cache_lifespan``,
``hashing_lifespan``{% if has_worker %}, ``token_lifespan`` and ``queue_lifespan``{% else %} and ``token_lifespan``{% endif %} are plain
async context managers — Keel takes no dependency on FastAPI — so they compose
in a single ``async with`` and the same lines wire a worker process or a
management command.{% if has_worker %} They very nearly are: see ``app.worker.serve``, which
opens the same ones in the same order, minus the token store.{% endif %} All of them close
their pools on the way out, which is the part that is forgotten until a few
hundred restarts have leaked it.
{% if has_worker %}
**This process dispatches; it does not consume.** Binding the queue is what
makes ``dispatch()`` work inside a service — the API half of a queue is the push
side. No worker runtime is imported here: ``keel.queue`` exports ``Worker``
lazily, so an API replica pays for none of it.
{% endif %}

**The caller is bound per request, not here.** The lifespan binds the *token
store*; turning a header into an identity is :mod:`app.security`'s job, and it
happens per request in a dependency. Which is also why the bearer dependency is
in this project rather than in Keel: it is FastAPI vocabulary, and the core
imports no web framework.

**No session is held across a request.** There is no ``get_session`` dependency
to import and this module does not invent one. A route receives nothing but its
payload, calls a service, and the service opens ``uow()`` around the work that
must be atomic. FastAPI PR #12066 is the reason: a session yielded from
``Depends`` stays open through response-model validation, so under load the pool
starves while every individual request still looks fast at p99.

**Logging is configured before anything else, and it is not a lifespan.** The
interesting failures happen *during* start-up — a bad URL, a refused pool — and
a lifespan runs too late to record them. ``configure_logging`` installs a JSON
formatter and a log record factory that puts the current request id on every
line, whichever module wrote it.{% if has_worker %} ``app.worker`` calls the same function with
the same settings, so one query joins an API line to the worker line for the job
it dispatched.{% endif %}

**Liveness and readiness are different questions.** Liveness touches nothing;
readiness asks every dependency a request can need, and ``READINESS`` below is
that list. A dependency added to the lifespan belongs in it too — a probe that
skips one reports ready while every request that needs it fails. Mail is the
one exception: no request needs the server to answer, a welcome that fails is
a log line or a retried job, and a probe on it would pull the API out of
rotation for a dead relay. ADR 0010 sends that class of fact to metrics.
"""

from __future__ import annotations

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

from fastapi import FastAPI
from fastapi.responses import JSONResponse, Response
from keel.auth import hashing_lifespan, token_lifespan
from keel.cache import cache_lifespan
from keel.database import current_database, database_lifespan
from keel.mail import mail_lifespan
from keel.observability import (
    Check,
    bound_metrics,
    check_cache,
    check_database,
{%- if has_worker %}
    check_queue,
{%- endif %}
    check_tokens,
    configure_logging,
    current_metrics,
    inspector_lifespan,
    metrics_lifespan,
    probe,
)
{%- if has_worker %}
from keel.queue import queue_lifespan
{%- endif %}
from keel.support.events import EventDispatcher

from app import __version__
from app.errors import register_error_handlers
from app.inspector import router as inspector_router
from app.modules import include_modules
from app.observability import METRICS_PATH, RequestContext, on_listener_error
from app.settings import Settings, get_settings

READINESS: dict[str, Check] = {
    "database": check_database,
    "cache": check_cache,
    # Every authenticated request resolves its bearer token here.
    "tokens": check_tokens,
{%- if has_worker %}
    # `dispatch()` pushes on this connection once the unit of work commits.
    "queue": check_queue,
{%- endif %}
}
"""What ``/ready`` asks, by the name its response body reports."""


def create_app(settings: Settings | None = None) -> FastAPI:
    """Build the application.

    A factory rather than a module-level singleton so that a test can build an
    application with its own settings without touching the environment, and so
    that importing this module has no side effects beyond the one ``app`` below.

    Args:
        settings: Configuration to use. Defaults to reading the environment,
            which is what a real deployment does.

    Returns:
        A configured application.
    """
    config = settings if settings is not None else get_settings()
    configure_logging(config.logging_config())

    @asynccontextmanager
    async def lifespan(_: FastAPI) -> AsyncIterator[None]:
        """Bind every subsystem for the life of the process.

        One dispatcher for everything that announces: the cache's stores and
        ``dispatch()`` publish on it, and the inspector reads it under ``DEBUG``.
        The inspector enters last because it watches what the others bound.
        """
        events = EventDispatcher(on_error=on_listener_error)
        async with (
            database_lifespan(config.database_config()),
            cache_lifespan(config.cache_config(), events),
            hashing_lifespan(config.hashing_config()),
            token_lifespan(config.token_config()),
            mail_lifespan(config.mail_config(), events),
{%- if has_worker %}
            queue_lifespan(config.queue_config(), events),
{%- endif %}
            inspector_lifespan(
                config.inspector_config(), database=current_database(), events=events
            ),
            metrics_lifespan(config.metrics_config(), database=current_database(), events=events),
        ):
            yield

    app = FastAPI(
        title=config.app_name,
        description="{{ description }}",
        version=__version__,
        lifespan=lifespan,
    )

    # Outermost user middleware, so the id is bound before routing and is still
    # bound when an error handler answers. See app/observability.py for the 500.
    app.add_middleware(RequestContext)
    register_error_handlers(app)
    include_modules(app)
    if config.debug:
        # Serves SQL text and log lines to whoever can reach it; see app/inspector.py.
        app.include_router(inspector_router)

    @app.get("/health", tags=["health"])
    async def health() -> dict[str, str]:
        """Liveness: is this process running?

        Always 200 while the process can answer. It deliberately touches
        nothing: a liveness probe that fails when the database is briefly
        unreachable gets the container killed and restarted, which does not fix
        the database and does lose every in-flight request.
        """
        return {"status": "ok", "service": config.app_name}

    @app.get("/ready", tags=["health"])
    async def ready() -> JSONResponse:
        """Readiness: can this process serve traffic?

        Asks every dependency in ``READINESS`` at once, each under a deadline,
        and answers 503 naming the one that failed, so the orchestrator stops
        routing here. The body carries each failure's exception class; the
        message, which can name a host, goes to the log.

        Every replica shares these dependencies, so an outage takes them all out
        of rotation together. That is the intended trade: during a rollout it is
        what stops a replica with a wrong ``DATABASE_URL`` from taking traffic.
        """
        report = await probe(READINESS)
        if (metrics := bound_metrics()) is not None:
            metrics.readiness(report)
        return JSONResponse(status_code=200 if report.ok else 503, content=report.as_dict())

    if config.metrics.enabled:

        @app.get(METRICS_PATH, tags=["health"], include_in_schema=False)
        async def metrics_exposition() -> Response:
            """What a Prometheus scraper reads.

            Requests by route template, statements by operation, cache round
            trips by outcome, jobs by name and outcome, readiness checks by
            result, and the process's own memory and CPU. No identifiers and no
            statement text, which is why it is served to whoever asks; a
            deployment that wants it private puts the scraper on the same
            network and the port behind it.
            """
            body, content_type = current_metrics().render()
            return Response(content=body, media_type=content_type)

    return app


app = create_app()
"""The application ``uvicorn app.main:app`` serves."""

__all__ = ["READINESS", "app", "create_app"]
