"""The wire types for password resets.

Pydantic only. This module must never import ``models``.

There is no read schema. Requesting a reset answers 202 with no body, whether
or not the address exists, and redeeming one answers 204. A body on either
would be a place for the difference between "sent" and "not sent" to leak.
"""

from __future__ import annotations

from pydantic import BaseModel, EmailStr, Field

from app.modules.users.schemas import PASSWORD_MAX_LENGTH, PASSWORD_MIN_LENGTH

CODE_MAX_LENGTH = 64
"""A code is 32 bytes of ``secrets`` output, URL-safe: 43 characters. Bounded
so a request cannot make the server hash a megabyte."""


class ResetRequest(BaseModel):
    """What a client sends to ask for a reset code.

    Attributes:
        email: The address on the account. The reply does not say whether it
            matched.
    """

    email: EmailStr


class ResetRedemption(BaseModel):
    """What a client sends to redeem a code.

    In the body rather than the path: the access log and the request inspector
    record paths, and a live credential does not belong in either.

    Attributes:
        code: The code from the message, presented as received.
        password: The replacement, held to the same rules as on create.
    """

    code: str = Field(min_length=1, max_length=CODE_MAX_LENGTH)
    password: str = Field(min_length=PASSWORD_MIN_LENGTH, max_length=PASSWORD_MAX_LENGTH)


__all__ = ["CODE_MAX_LENGTH", "ResetRedemption", "ResetRequest"]
