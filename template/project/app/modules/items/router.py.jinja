"""HTTP for items.

Two routers over one service. ``/items`` is the caller's own: the session
already names the owner, so a client never sends its own id over the wire.
``/users/{owner_id}/items`` names an owner, which is what an administrator
needs to act for somebody, and the policy decides whether they may. Both call
the same service functions with an owner id, which is why nothing beneath this
file knows there are two.

**Every route takes ``Caller``, and none of them decides ownership.** The 401
for a missing token is this file's; the 403 for somebody else's items is
``items_policy`` in ``app/policies.py``, asked by the service. That split is
why these routes could finally be guarded at all: the dependency they were
waiting for compared a path parameter spelled ``user_id`` against the caller,
and this path says ``owner_id``, so it never fitted. A rule that takes the
resource rather than the request does not care what the path spells.

Every route carries a tag, and no route touches a session or a repository.
"""

from __future__ import annotations

from typing import Annotated
from uuid import UUID

from fastapi import APIRouter, Query, status

from app.modules.items import service
from app.modules.items.repository import DEFAULT_PAGE_SIZE
from app.modules.items.schemas import ItemCreate, ItemRead, ItemUpdate
from app.security import Caller

mine = APIRouter(prefix="/items", tags=["items"])
"""The caller's own items. The session names the owner, so the URL does not."""

of_owner = APIRouter(prefix="/users/{owner_id}/items", tags=["items"])
"""One named owner's items: what an administrator uses to act for somebody."""

router = APIRouter()
router.include_router(mine)
router.include_router(of_owner)


@mine.post("", status_code=status.HTTP_201_CREATED, summary="Create one of my items")
async def create_my_item(payload: ItemCreate, caller: Caller) -> ItemRead:
    """Create an item owned by the caller.

    Args:
        payload: The requested item.
        caller: Whose item it becomes.

    Returns:
        The created item.
    """
    return await service.create_item(caller.id, payload)


@mine.get("", summary="List my items")
async def list_my_items(
    caller: Caller,
    limit: Annotated[int, Query(ge=1, le=200)] = DEFAULT_PAGE_SIZE,
    offset: Annotated[int, Query(ge=0)] = 0,
) -> list[ItemRead]:
    """Return a page of the caller's items, oldest first.

    Args:
        caller: Whose items to return.
        limit: Maximum rows to return.
        offset: Rows to skip.

    Returns:
        The page.
    """
    return await service.list_items(caller.id, limit=limit, offset=offset)


@mine.get("/{item_id}", summary="Fetch one of my items")
async def get_my_item(item_id: UUID, caller: Caller) -> ItemRead:
    """Return one of the caller's items.

    Args:
        item_id: The item's id.
        caller: Who it must belong to.

    Returns:
        The item.
    """
    return await service.get_item(item_id, caller.id)


@mine.patch("/{item_id}", summary="Update one of my items")
async def update_my_item(item_id: UUID, payload: ItemUpdate, caller: Caller) -> ItemRead:
    """Apply a partial update to one of the caller's items.

    Args:
        item_id: The item's id.
        payload: The fields to change.
        caller: Who it must belong to.

    Returns:
        The updated item.
    """
    return await service.update_item(item_id, caller.id, payload)


@mine.delete("/{item_id}", status_code=status.HTTP_204_NO_CONTENT, summary="Delete one of my items")
async def delete_my_item(item_id: UUID, caller: Caller) -> None:
    """Delete one of the caller's items.

    Args:
        item_id: The item's id.
        caller: Who it must belong to.
    """
    await service.delete_item(item_id, caller.id)


@of_owner.post("", status_code=status.HTTP_201_CREATED, summary="Create an item for an owner")
async def create_item(owner_id: UUID, payload: ItemCreate, _: Caller) -> ItemRead:
    """Create an item owned by the user in the path.

    Ownership comes from the URL and is not a body field, so a request cannot
    create an item for somebody else by disagreeing with its own path. Whether
    the caller may act for that owner is the policy's answer.

    Args:
        owner_id: The owning user.
        payload: The requested item.
        _: Declared for the dependency: 401 without a token.

    Returns:
        The created item.
    """
    return await service.create_item(owner_id, payload)


@of_owner.get("", summary="List an owner's items")
async def list_items(
    owner_id: UUID,
    _: Caller,
    limit: Annotated[int, Query(ge=1, le=200)] = DEFAULT_PAGE_SIZE,
    offset: Annotated[int, Query(ge=0)] = 0,
) -> list[ItemRead]:
    """Return a page of one owner's items, oldest first.

    Args:
        owner_id: Whose items to return.
        _: Declared for the dependency.
        limit: Maximum rows to return.
        offset: Rows to skip.

    Returns:
        The page.
    """
    return await service.list_items(owner_id, limit=limit, offset=offset)


@of_owner.get("/{item_id}", summary="Fetch an owner's item")
async def get_item(owner_id: UUID, item_id: UUID, _: Caller) -> ItemRead:
    """Return one of an owner's items.

    Args:
        owner_id: The owning user.
        item_id: The item's id.
        _: Declared for the dependency.

    Returns:
        The item.
    """
    return await service.get_item(item_id, owner_id)


@of_owner.patch("/{item_id}", summary="Update an owner's item")
async def update_item(owner_id: UUID, item_id: UUID, payload: ItemUpdate, _: Caller) -> ItemRead:
    """Apply a partial update.

    Args:
        owner_id: The owning user.
        item_id: The item's id.
        payload: The fields to change.
        _: Declared for the dependency.

    Returns:
        The updated item.
    """
    return await service.update_item(item_id, owner_id, payload)


@of_owner.delete(
    "/{item_id}", status_code=status.HTTP_204_NO_CONTENT, summary="Delete an owner's item"
)
async def delete_item(owner_id: UUID, item_id: UUID, _: Caller) -> None:
    """Delete one of an owner's items.

    Args:
        owner_id: The owning user.
        item_id: The item's id.
        _: Declared for the dependency.
    """
    await service.delete_item(item_id, owner_id)
