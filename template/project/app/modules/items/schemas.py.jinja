"""The wire types for items.

Pydantic only; no model imports.

No schema carries an owner. The owner is whoever the route was addressed to —
the caller at ``/items``, a named account at ``/users/{owner_pid}/items`` — so
it cannot be set or changed by a body that disagrees with the path, and
transferring ownership stays a distinct operation with its own rules rather
than a field in a partial update. What comes back carries the item's ``pid``
and never a primary key.
"""

from __future__ import annotations

from datetime import datetime
from uuid import UUID

from pydantic import BaseModel, ConfigDict, Field


class ItemCreate(BaseModel):
    """What a client sends to create an item.

    Attributes:
        name: Short label.
        description: Optional long text.
    """

    name: str = Field(min_length=1, max_length=200)
    description: str | None = None


class ItemUpdate(BaseModel):
    """A partial update. Unset fields are left alone.

    Attributes:
        name: A new label.
        description: New text, or ``None`` to clear it.
    """

    name: str | None = Field(default=None, min_length=1, max_length=200)
    description: str | None = None


class ItemRead(BaseModel):
    """What the API returns for an item.

    Attributes:
        pid: The public identifier, the one a URL names. Neither the primary
            key nor the owner's is returned: the owner is whoever the route
            was addressed to.
        name: Short label.
        description: Optional long text.
        created_at: Server-side timestamp, always UTC-aware.
        updated_at: Server-side timestamp, always UTC-aware.
    """

    model_config = ConfigDict(from_attributes=True)

    pid: UUID
    name: str
    description: str | None
    created_at: datetime
    updated_at: datetime


__all__ = ["ItemCreate", "ItemRead", "ItemUpdate"]
