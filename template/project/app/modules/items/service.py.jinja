"""Business logic for items.

Same two rules as the users service: ``uow()`` spans the work rather than the
request, and what comes back is a schema rather than an ORM object whose session
has closed.

One thing is new here — this module imports another module's repository, to
check that an owner exists before creating an item. That is the sanctioned
direction of coupling in this layout: a module may reach into a *sibling's*
service or repository, but nothing reaches upward into a router. Doing the check
explicitly rather than letting the foreign key fail turns a 500 with an
``IntegrityError`` in the logs into a 404 that says which user is missing.

**Every function that acts on an owner's items calls ``authorize`` with the
owner's primary key.** The rule lives in ``app/policies.py``; this layer only
says which ability is being exercised on whose items. It is here rather than in
the router because this is the seam every entrypoint goes through — the router,
{% if has_worker %}a job handler, {% endif %}a management command, a test — and a guard on the HTTP edge
protects only the callers that arrive over HTTP. The caller's own routes hand
over the key the session already holds; the owner-addressed routes first turn
the public identifier they were given into a key with :func:`resolve_owner`,
one read by a random ``pid`` that an authenticated caller was given (ADR 0014).

**No error message names a primary key.** A ``NotFoundError``'s detail is
copied into the response body, so it says ``pid`` or nothing.
{% if has_worker %}
This module is also where the two entrypoints meet. ``create_item`` dispatches
:class:`app.modules.items.jobs.IndexItem` from inside its unit of work, so the
job is pushed only if the transaction commits — and the handler that eventually
runs it calls :func:`get_item` below, the same function the router calls. There
is no worker-only path into this domain.
{% endif %}"""

from __future__ import annotations

from typing import Any
from uuid import UUID

from keel.auth import authorize
from keel.database import uow
{%- if has_worker %}
from keel.queue import dispatch
{%- endif %}

from app.errors import NotFoundError
from app.modules.items.repository import DEFAULT_PAGE_SIZE, ItemRepository
from app.modules.items.schemas import ItemCreate, ItemRead, ItemUpdate
from app.modules.users.repository import UserRepository
from app.policies import ItemsOf


async def create_item(owner_id: UUID, payload: ItemCreate) -> ItemRead:
    """Create an item for an existing owner.

    Args:
        owner_id: The user who will own it.
        payload: The requested item.

    Returns:
        The created item.

    Raises:
        AuthorizationDeniedError: If the caller may not add to this owner's
            items.
        NotFoundError: If the owner does not exist. Without naming its key:
            the detail reaches the response body.
    """
    authorize("create", ItemsOf(owner_id))
{%- if has_worker %}
    # Deferred because `jobs` imports this module: a module-level import back would
    # be a cycle. By the first request this is only a `sys.modules` lookup.
    from app.modules.items.jobs import IndexItem
{% endif %}
    async with uow() as session:
        if await UserRepository(session).get(owner_id) is None:
            raise NotFoundError("no such owner")

        item = await ItemRepository(session).create(
            name=payload.name,
            description=payload.description,
            owner_id=owner_id,
        )
        result = ItemRead.model_validate(item)
{%- if has_worker %}

        # Inside the unit of work deliberately: `dispatch` holds the push until the
        # transaction commits, so a worker never sees a job for a rolled-back row.
        await dispatch(IndexItem(item_pid=str(item.pid), owner_id=str(owner_id)))
{%- endif %}

        return result


async def resolve_owner(owner_pid: UUID) -> UUID:
    """Return the primary key behind an owner's public identifier.

    What the owner-addressed routes call first: the URL names a ``pid``, the
    service and the policy work in primary keys, and this is the one place
    the translation happens. It is its own unit of work, so an owner deleted
    between this call and the next is a clean 404 from the next one — one
    that names no key.

    Args:
        owner_pid: The owner's public identifier.

    Returns:
        The owner's primary key.

    Raises:
        NotFoundError: If there is no such user.
    """
    async with uow() as session:
        user = await UserRepository(session).get_by_pid(owner_pid)
        if user is None:
            raise NotFoundError(f"no user with pid {owner_pid}")
        return user.id


async def list_items(
    owner_id: UUID,
    *,
    limit: int = DEFAULT_PAGE_SIZE,
    offset: int = 0,
) -> list[ItemRead]:
    """Return a page of one owner's items.

    Args:
        owner_id: Whose items to return.
        limit: Maximum rows to return.
        offset: Rows to skip.

    Returns:
        The page, as schemas.

    Raises:
        AuthorizationDeniedError: If the caller may not read this owner's items.
    """
    authorize("view", ItemsOf(owner_id))
    async with uow() as session:
        found = await ItemRepository(session).list(owner_id, limit=limit, offset=offset)
        return [ItemRead.model_validate(item) for item in found]


async def get_item(pid: UUID, owner_id: UUID) -> ItemRead:
    """Return one of an owner's items.

    An item belonging to someone else is reported as missing rather than as
    forbidden: telling a caller that a resource exists but is not theirs leaks
    the existence of the resource.

    Args:
        pid: The item's public identifier.
        owner_id: The owner it must belong to.

    Returns:
        The item.

    Raises:
        AuthorizationDeniedError: If the caller may not read this owner's items.
        NotFoundError: If there is no such item for that owner.
    """
    authorize("view", ItemsOf(owner_id))
    async with uow() as session:
        item = await ItemRepository(session).get_for_owner(pid, owner_id)
        if item is None:
            raise NotFoundError(f"no item with pid {pid}")
        return ItemRead.model_validate(item)


async def update_item(pid: UUID, owner_id: UUID, payload: ItemUpdate) -> ItemRead:
    """Apply a partial update to one of an owner's items.

    Args:
        pid: The item's public identifier.
        owner_id: The owner it must belong to.
        payload: The fields to change. Unset fields are left alone; ``owner_id``
            is not among them, because transferring ownership is a different
            operation with different rules.

    Returns:
        The updated item.

    Raises:
        AuthorizationDeniedError: If the caller may not write this owner's items.
        NotFoundError: If there is no such item for that owner.
    """
    authorize("update", ItemsOf(owner_id))
    async with uow() as session:
        items = ItemRepository(session)
        item = await items.get_for_owner(pid, owner_id)
        if item is None:
            raise NotFoundError(f"no item with pid {pid}")

        changes: dict[str, Any] = payload.model_dump(exclude_unset=True)
        updated = await items.update(item, changes)
        return ItemRead.model_validate(updated)


async def delete_item(pid: UUID, owner_id: UUID) -> None:
    """Delete one of an owner's items.

    Args:
        pid: The item's public identifier.
        owner_id: The owner it must belong to.

    Raises:
        AuthorizationDeniedError: If the caller may not write this owner's items.
        NotFoundError: If there is no such item for that owner.
    """
    authorize("delete", ItemsOf(owner_id))
    async with uow() as session:
        items = ItemRepository(session)
        item = await items.get_for_owner(pid, owner_id)
        if item is None:
            raise NotFoundError(f"no item with pid {pid}")
        await items.delete(item)


__all__ = [
    "create_item",
    "delete_item",
    "get_item",
    "list_items",
    "resolve_owner",
    "update_item",
]
