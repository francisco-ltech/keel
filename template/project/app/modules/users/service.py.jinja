"""Business logic for users.

Module-level functions rather than a service class: there is no per-instance
state to hold, and a free function is trivially callable from a worker, a CLI
command or a test without constructing anything.

Two rules are load-bearing here, and both are about the session.

**The transaction spans the work, not the request.** Each function opens
``uow()`` around exactly the reads and writes that must be atomic. The session
is closed — and the connection returned to the pool — before the response is
serialised. This is the whole reason Keel ships no ``get_session`` dependency.

**Services return schemas, not ORM objects.** Handing a router a ``User`` means
handing it an object whose session has closed. Any attribute that was not loaded
raises on access, and because it usually *is* loaded in development, the failure
arrives in production on the one code path that lazily touched a relationship.
Validating into a :class:`~app.modules.users.schemas.UserRead` inside the block
makes that class of bug unrepresentable.

**Authorization is here, not in the router.** Every function that acts on a
named account opens with ``authorize``, before any unit of work, and the rule it
consults lives in ``app/policies.py``. The router says who is calling; this
layer says what they may do with that. Putting it on the HTTP edge would guard
only the callers who arrive over HTTP, and this module is reachable from
{% if has_worker %}a job handler, {% endif %}a management command and a test. ``create_user`` is the
one exception, and it is deliberate: registration has to work for somebody who
has no credential yet.

**Hashing comes from Keel.** :class:`keel.auth.PasswordHasher` uses the cost
parameters bound by ``hashing_lifespan`` at startup, so they are configuration
rather than a constant compiled into this module — which is what lets the test
suite turn them down without moving the production default. It also brings the
two things a hand-rolled pair leaves out: a constant-cost miss, and
rehash-on-login.

**Argon2 never runs on the event loop, and never inside ``uow()``.** It is tens
of milliseconds of deliberate CPU work: run inline it stalls every other request
in the process, and run inside a transaction it does that *while* holding a
pooled connection that needs nothing from the database. Both are fixed by the
same two words — ``to_thread`` outside the block — and :func:`hash_in_a_thread`
is where that lives. ADR 0002, rule 3.
"""

from __future__ import annotations

from typing import Any
from uuid import UUID

import anyio
from keel.auth import authorize, password_hasher{% if has_api %}, token_store{% endif %}
from keel.database import uow

from app.errors import ConflictError, ForbiddenError, NotFoundError
from app.modules.users.repository import DEFAULT_PAGE_SIZE, UserRepository
from app.modules.users.schemas import PasswordChange, UserCreate, UserRead, UserUpdate
from app.policies import Account


async def hash_in_a_thread(plaintext: str) -> str:
    """Hash a password without blocking the loop or holding a connection.

    The hasher is resolved here, on the loop, and only the hashing itself is
    handed to a worker thread — so a test that swaps the bound hasher still sees
    its own, whatever the thread's context turns out to carry.

    Args:
        plaintext: The password as typed.

    Returns:
        The hash to store.
    """
    return await anyio.to_thread.run_sync(password_hasher().hash, plaintext)


async def create_user(payload: UserCreate) -> UserRead:
    """Create a user.

    Args:
        payload: The requested user.

    Returns:
        The created user.

    Raises:
        ConflictError: If the email address is already taken. Checked inside the
            transaction, which narrows but does not close the race; the unique
            index on the column is what actually guarantees it.
    """
    # Before the block, not inside it: hashing needs no database, and a
    # duplicate address costs the same as a new one either way.
    hashed = await hash_in_a_thread(payload.password)

    async with uow() as session:
        users = UserRepository(session)
        if await users.get_by_email(payload.email) is not None:
            raise ConflictError(f"a user with email {payload.email!r} already exists")

        user = await users.create(
            email=payload.email,
            full_name=payload.full_name,
            hashed_password=hashed,
        )
        return UserRead.model_validate(user)


async def list_users(*, limit: int = DEFAULT_PAGE_SIZE, offset: int = 0) -> list[UserRead]:
    """Return a page of users.

    No ``authorize`` call, and that is the distinction worth keeping: a listing
    names no resource, so "may I read *this*" has nothing to be asked about.
    Requiring a caller at all is authentication, and the route declares it. A
    listing that has to be filtered per row is a different function, and it
    filters with ``keel.auth.allows`` rather than raising.

    Args:
        limit: Maximum rows to return.
        offset: Rows to skip.

    Returns:
        The page, as schemas.
    """
    async with uow() as session:
        found = await UserRepository(session).list(limit=limit, offset=offset)
        return [UserRead.model_validate(user) for user in found]


async def get_user(user_id: UUID) -> UserRead:
    """Return one user.

    Args:
        user_id: The primary key.

    Returns:
        The user.

    Raises:
        AuthorizationDeniedError: If the caller may not read this account.
        NotFoundError: If there is no such user.
    """
    authorize("view", Account(user_id))
    async with uow() as session:
        user = await UserRepository(session).get(user_id)
        if user is None:
            raise NotFoundError(f"no user with id {user_id}")
        return UserRead.model_validate(user)


async def update_user(user_id: UUID, payload: UserUpdate) -> UserRead:
    """Apply a partial update.

    Carries no password: replacing one is :func:`change_password`, which demands
    the current password first. See :class:`~app.modules.users.schemas.UserUpdate`.

    Args:
        user_id: The primary key.
        payload: The fields to change. Unset fields are left alone.

    Returns:
        The updated user.

    Raises:
        AuthorizationDeniedError: If the caller may not change this account.
            Refused before the row is read, so a stranger learns nothing about
            which ids exist.
        NotFoundError: If there is no such user.
        ConflictError: If the new email address belongs to someone else.
    """
    authorize("update", Account(user_id))
    async with uow() as session:
        users = UserRepository(session)
        user = await users.get(user_id)
        if user is None:
            raise NotFoundError(f"no user with id {user_id}")

        # `exclude_unset`, not `exclude_none`: sending `is_active: null` means
        # something different from omitting it, and a partial update needs both.
        changes: dict[str, Any] = payload.model_dump(exclude_unset=True)

        email = changes.get("email")
        if email is not None and email != user.email:
            clash = await users.get_by_email(email)
            if clash is not None:
                raise ConflictError(f"a user with email {email!r} already exists")

        updated = await users.update(user, changes)
        result = UserRead.model_validate(updated)
{%- if has_api %}

    # After the commit and outside the block: revoking is a token-store round
    # trip, and an account whose tokens still work has not been disabled.
    if changes.get("is_active") is False:
        await token_store().revoke_subject(user_id)
{%- endif %}

    return result


async def change_password(user_id: UUID, payload: PasswordChange) -> None:
    """Replace a password, having proved knowledge of the one in force.

    The current password is required even though the caller is already
    authenticated. A bearer token can be stolen; the password is the second
    factor that makes the theft insufficient to lock the owner out, and it is
    the reason this is not a field on :class:`~app.modules.users.schemas.UserUpdate`.

    Three units of work would be wrong here and there are two: the row is read,
    the block closes for the hashing, and a second block writes the replacement.
    Nothing between them can leave the account without a password — the write is
    a single ``UPDATE``.

    Args:
        user_id: Whose password to change.
        payload: The current password and its replacement.

    Returns:
        Nothing. The new password is not echoed and no new session is issued;
        the caller signs in again, which is the point of revoking the old ones.

    Raises:
        AuthorizationDeniedError: If the caller is not the account's owner. Not
            even an admin: this route's precondition is the password in force,
            and somebody who knew it would not need the route.
        NotFoundError: If there is no such user.
        ForbiddenError: If the current password does not match. A 403 rather
            than a 401 for the reason ADR 0007 gives about not answering a
            working credential with a challenge: the *token* was accepted, and
            telling a client to re-authenticate would sign the caller out over a
            typo.
    """
    authorize("change-password", Account(user_id))
    async with uow() as session:
        user = await UserRepository(session).get(user_id)
        if user is None:
            raise NotFoundError(f"no user with id {user_id}")
        stored = user.hashed_password

    hasher = password_hasher()
    matched = await anyio.to_thread.run_sync(hasher.verify, payload.current_password, stored)
    if not matched:
        raise ForbiddenError("the current password is incorrect")
    hashed = await hash_in_a_thread(payload.new_password)

    async with uow() as session:
        users = UserRepository(session)
        user = await users.get(user_id)
        if user is None:
            raise NotFoundError(f"no user with id {user_id}")
        await users.update(user, {"hashed_password": hashed})
{%- if has_api %}

    # Every device that was signed in with the old password stops working. A
    # password change that leaves a stolen token live has changed nothing.
    await token_store().revoke_subject(user_id)
{%- endif %}


async def delete_user(user_id: UUID) -> None:
    """Delete a user, and by cascade everything they own.

    Args:
        user_id: The primary key.

    Raises:
        AuthorizationDeniedError: If the caller may not delete this account.
        NotFoundError: If there is no such user.
    """
    authorize("delete", Account(user_id))
    async with uow() as session:
        users = UserRepository(session)
        user = await users.get(user_id)
        if user is None:
            raise NotFoundError(f"no user with id {user_id}")
        await users.delete(user)
{%- if has_api %}

    # The row is gone; the tokens naming it are not, and one would still resolve
    # to an identity that passes an ownership check.
    await token_store().revoke_subject(user_id)
{%- endif %}


__all__ = [
    "change_password",
    "create_user",
    "delete_user",
    "get_user",
    "hash_in_a_thread",
    "list_users",
    "update_user",
]
