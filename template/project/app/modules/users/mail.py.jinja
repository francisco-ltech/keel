"""The messages the users module sends.

A function per message, naming the template pair under ``app/templates/mail``,
the recipients and the subject. The bodies live in the templates and their
look in ``layout.html.j2``; see ``app/mail.py``. Nothing here sends:
:func:`keel.mail.send` does, from a job or after a commit, which is the
caller's decision rather than the message's.
"""

from __future__ import annotations

from typing import TYPE_CHECKING

from app.mail import APP_NAME, templates
from app.modules.users.schemas import UserRead

if TYPE_CHECKING:
    from keel.mail import Message

WELCOME_SUBJECT = f"Welcome to {APP_NAME}"


def welcome(user: UserRead) -> Message:
    """Build the message a new account receives.

    Args:
        user: The account, as the API describes it.

    Returns:
        The message, sender left to the configuration.
    """
    return templates.message("welcome", to=user.email, subject=WELCOME_SUBJECT, user=user)


__all__ = ["WELCOME_SUBJECT", "welcome"]
