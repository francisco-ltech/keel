"""Queries against the ``users`` table.

A repository takes a session; it never opens one. The caller — always a service
— owns the transaction boundary, which is what lets two repositories take part
in the same unit of work and what keeps the connection out of the response path.

SQLAlchemy 2.0 ``select()`` style throughout, deliberately explicit. There is no
generic ``BaseRepository`` yet: that arrives in Phase 2, once there are enough
modules to show which methods actually repeat. A base class extracted from two
examples usually encodes a coincidence.
"""

from __future__ import annotations

from collections.abc import Mapping, Sequence
from typing import TYPE_CHECKING
from uuid import UUID

from sqlalchemy import select, update

from app.modules.users.models import User

if TYPE_CHECKING:
    from sqlalchemy.ext.asyncio import AsyncSession

DEFAULT_PAGE_SIZE = 50
"""Rows returned when a caller does not say. An unbounded list endpoint is a
table scan waiting for the table to grow."""


class UserRepository:
    """Data access for :class:`~app.modules.users.models.User`.

    Args:
        session: The session to run against. Supplied by the service inside its
            ``uow()`` block, never opened here.
    """

    __slots__ = ("_session",)

    def __init__(self, session: AsyncSession) -> None:
        self._session = session

    async def get(self, user_id: UUID) -> User | None:
        """Return a user by id.

        Args:
            user_id: The primary key.

        Returns:
            The user, or ``None`` if there is no such row.
        """
        return await self._session.get(User, user_id)

    async def lock(self, user_id: UUID) -> User | None:
        """Return a user by id, holding its row lock until the commit.

        ``SELECT ... FOR UPDATE``: a second transaction asking for the same
        account waits here, then reads what the first one committed. That is
        what turns a read-then-write into a serial sequence, and what gives
        every path that touches an account and its reset codes the same lock
        order, account first, so two of them cannot deadlock.

        Args:
            user_id: The primary key.

        Returns:
            The user, or ``None`` if there is no such row.
        """
        result = await self._session.execute(
            select(User).where(User.id == user_id).with_for_update()
        )
        return result.scalar_one_or_none()

    async def get_by_pid(self, pid: UUID) -> User | None:
        """Return a user by public identifier: what a route names.

        Args:
            pid: The public identifier.

        Returns:
            The user, or ``None`` if there is no such row.
        """
        result = await self._session.execute(select(User).where(User.pid == pid))
        return result.scalar_one_or_none()

    async def get_by_email(self, email: str) -> User | None:
        """Return a user by email address.

        Args:
            email: The address to look up.

        Returns:
            The user, or ``None``.
        """
        result = await self._session.execute(select(User).where(User.email == email))
        return result.scalar_one_or_none()

    async def list(
        self,
        *,
        limit: int = DEFAULT_PAGE_SIZE,
        offset: int = 0,
    ) -> Sequence[User]:
        """Return a page of users, oldest first.

        Ordered by ``id`` as well as ``created_at`` because Postgres' ``now()``
        is the *transaction* timestamp: every row written in one transaction
        shares a ``created_at``, so that column alone is not a total order.

        Args:
            limit: Maximum rows to return.
            offset: Rows to skip.

        Returns:
            The page.
        """
        statement = select(User).order_by(User.created_at, User.id).limit(limit).offset(offset)
        result = await self._session.execute(statement)
        return result.scalars().all()

    async def create(self, *, email: str, full_name: str, hashed_password: str) -> User:
        """Insert a user.

        Flushes so the row's application-generated id and its server-side
        timestamps are available to the caller, then refreshes so nothing is
        left expired: reading an expired attribute outside an awaited SQLAlchemy
        call raises ``MissingGreenlet``, which is a confusing way to learn this.

        Args:
            email: The address.
            full_name: Display name.
            hashed_password: An already-hashed password. Hashing is the
                service's job; this layer never sees plaintext.

        Returns:
            The persisted user.
        """
        user = User(email=email, full_name=full_name, hashed_password=hashed_password)
        self._session.add(user)
        await self._session.flush()
        return user

    async def update(self, user: User, changes: Mapping[str, object]) -> User:
        """Apply changes to a user and flush them.

        Args:
            user: The row to change, already loaded in this session.
            changes: Column names to new values. The service is responsible for
                deciding what is allowed in here — a repository that accepts an
                arbitrary mapping from a request body is a mass-assignment bug.

        Returns:
            The updated user.
        """
        for key, value in changes.items():
            setattr(user, key, value)
        await self._session.flush()
        return user

    async def replace_hash_if_unchanged(self, user_id: UUID, *, expected: str, new: str) -> bool:
        """Swap a stored password hash, but only if it is still the one seen.

        A compare-and-set rather than a read-then-write, because the caller read
        that hash before spending ~40ms hashing outside the transaction. A blind
        write would silently revert a password change committed during it.

        Args:
            user_id: Whose row to update.
            expected: The hash the caller verified against.
            new: The replacement.

        Returns:
            Whether the row still held *expected* and was updated. ``False``
            means someone else changed it first, and the caller should leave it
            alone — a rehash is an optimisation, not a race to win.
        """
        result = await self._session.execute(
            update(User)
            .where(User.id == user_id, User.hashed_password == expected)
            .values(hashed_password=new)
            .returning(User.id)
        )
        return result.scalar_one_or_none() is not None

    async def delete(self, user: User) -> None:
        """Delete a user.

        Args:
            user: The row to delete.
        """
        await self._session.delete(user)
        await self._session.flush()


__all__ = ["DEFAULT_PAGE_SIZE", "UserRepository"]
