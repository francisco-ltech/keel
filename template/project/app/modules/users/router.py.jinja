"""HTTP for users.

This layer knows about status codes, paths and payloads. It does not know about
sessions, repositories or SQLAlchemy — every handler is one call into
:mod:`app.modules.users.service`. If a handler ever needs a second call to make
a change atomic, that is a sign the operation belongs in the service, not here.

Every route carries a tag. Untagged routes land in FastAPI's ``default`` group
in the generated documentation, which is where endpoints go to be forgotten.

**One route is open, and the rest are not.** ``POST /users`` is registration and
has to be reachable by somebody with no credential. Everything else takes
``Caller`` from :mod:`app.security`, which answers 401 when there is no valid
token — and that is *all* this file decides.

**Which caller may do what is not here.** It is a policy in ``app/policies.py``,
asked by the service. So the annotations below are uniform where they used to be
a mix of ``Caller`` and ``Owner``: the question "is somebody there" is the
router's, and "may that somebody" belongs with the operation, where a job or a
management command reaching the same function gets the same answer. The
reasoning behind each rule is worth keeping when you adapt this:

* **The listing is an administrator's.** ``GET /users`` returns every registered
  email address, which is the exact question ``POST /sessions`` spends ~40 ms
  of Argon2 and a page of prose refusing to answer. An enumeration defence with
  a JSON listing one route over is not a defence, so ``directory_policy`` hands
  the listing to the admin role and nobody else. Widen it if your users are
  genuinely a public directory — but decide that, rather than inherit it.
* **The writes are behind ownership**, decided by ``account_policy``. ``PATCH``
  and ``DELETE`` change or remove an account, so an unauthenticated one is
  account takeover: read an address from the listing, set a password on it, sign
  in. The policy answers 403 for anybody but the owner or an admin.
* **The password has its own route**, demands the current one, and is the
  owner's alone — an admin is refused it too. A password set through a general
  partial update is a takeover primitive even behind authentication, because it
  needs no knowledge of the password it replaces.

Registration remains a weaker oracle: a duplicate address is a 409. Closing that
means a flow that answers identically either way and mails the difference, which
is application policy and a table, not a parameter.
"""

from __future__ import annotations

from typing import Annotated
from uuid import UUID

from fastapi import APIRouter, Query, status

from app.modules.users import service
from app.modules.users.repository import DEFAULT_PAGE_SIZE
from app.modules.users.schemas import PasswordChange, UserCreate, UserRead, UserUpdate
from app.security import Caller

router = APIRouter(prefix="/users", tags=["users"])


@router.post("", status_code=status.HTTP_201_CREATED, summary="Create a user")
async def create_user(payload: UserCreate) -> UserRead:
    """Create a user.

    Args:
        payload: The requested user. ``password`` is write-only.

    Returns:
        The created user, without any password field.
    """
    return await service.create_user(payload)


@router.get("", summary="List users")
async def list_users(
    _: Caller,
    limit: Annotated[int, Query(ge=1, le=200)] = DEFAULT_PAGE_SIZE,
    offset: Annotated[int, Query(ge=0)] = 0,
) -> list[UserRead]:
    """Return a page of users, oldest first.

    Args:
        _: Declared for the dependency, not for the body. A listing of every
            registered address is the answer the sign-in path refuses to give,
            so the policy limits it to an administrator.
        limit: Maximum rows to return.
        offset: Rows to skip.

    Returns:
        The page.
    """
    return await service.list_users(limit=limit, offset=offset)


@router.get("/{pid}", summary="Fetch a user")
async def get_user(pid: UUID, _: Caller) -> UserRead:
    """Return one user.

    The owner or an administrator: ``account_policy``'s ``view`` arm in
    ``app/policies.py`` decides, and widening it changes no route, which is
    the point of the seam.

    Args:
        pid: The user's public identifier.
        _: Declared for the dependency.

    Returns:
        The user.
    """
    return await service.get_user(pid)


@router.patch("/{pid}", summary="Update a user")
async def update_user(pid: UUID, payload: UserUpdate, _: Caller) -> UserRead:
    """Apply a partial update.

    ``PATCH`` rather than ``PUT`` because the payload is partial: omitted fields
    are left alone rather than cleared.

    Args:
        pid: The user's public identifier.
        payload: The fields to change. No password; see
            :func:`change_password`.
        _: Declared for the dependency: 401 without a token. The 403 for
            somebody else's account comes from the service's policy.

    Returns:
        The updated user.
    """
    return await service.update_user(pid, payload)


@router.put(
    "/{pid}/password",
    status_code=status.HTTP_204_NO_CONTENT,
    summary="Change a password",
)
async def change_password(pid: UUID, payload: PasswordChange, _: Caller) -> None:
    """Replace a password, given the current one, and sign every device out.

    ``PUT`` on a sub-resource rather than a field on ``PATCH /users/{pid}``:
    it is a whole replacement with its own precondition, and separating it is
    what makes the precondition unskippable.

    Args:
        pid: The user's public identifier.
        payload: The current password and its replacement.
        _: Declared for the dependency.
    """
    await service.change_password(pid, payload)


@router.delete("/{pid}", status_code=status.HTTP_204_NO_CONTENT, summary="Delete a user")
async def delete_user(pid: UUID, _: Caller) -> None:
    """Delete a user and everything they own.

    Args:
        pid: The user's public identifier.
        _: Declared for the dependency.
    """
    await service.delete_user(pid)


__all__ = ["router"]
