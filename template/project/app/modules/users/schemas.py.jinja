"""The wire types for users.

Pydantic only. This module must never import ``models``.

The split is what makes ``password`` safe. It appears on the way in
(:class:`UserCreate`, :class:`PasswordChange`) and has no counterpart on the way
out (:class:`UserRead`), so there is no field to forget to exclude and no
``exclude={"password"}`` to leave off one serialiser. A write-only field is
better enforced by absence than by configuration.

**:class:`UserUpdate` carries no password, and that is a security boundary
rather than tidiness.** A password inside a general partial update is a password
that can be set by anything holding a write on the row, without proving
knowledge of the old one — which turns "edit your profile" into "take over this
account" the moment an authorization check is loosened anywhere.
:class:`PasswordChange` demands the current password, so the primitive does not
exist to be reached by accident.
"""

from __future__ import annotations

from datetime import datetime
from uuid import UUID

from pydantic import BaseModel, ConfigDict, EmailStr, Field

PASSWORD_MIN_LENGTH = 8
"""Short enough to be usable, long enough that the Argon2 cost matters."""

PASSWORD_MAX_LENGTH = 128
"""Bounded because an unbounded password is an unbounded amount of hashing, and
therefore a denial-of-service vector."""


class UserCreate(BaseModel):
    """What a client sends to create a user.

    Attributes:
        email: Must be unique; the service reports a 409 if it is not.
        full_name: Display name.
        password: Write-only. Hashed by the service and never returned.
    """

    email: EmailStr
    full_name: str = Field(min_length=1, max_length=200)
    password: str = Field(min_length=PASSWORD_MIN_LENGTH, max_length=PASSWORD_MAX_LENGTH)


class UserUpdate(BaseModel):
    """A partial update. Unset fields are left alone.

    ``exclude_unset`` is what makes the distinction between "not mentioned" and
    "explicitly set to null" survive the round trip, so the service reads the
    payload that way rather than with ``exclude_none``.

    Attributes:
        email: A new address, still subject to uniqueness.
        full_name: A new display name.
        is_active: Soft enable or disable. Disabling revokes every live session,
            because an account that can still make authenticated requests has
            not been disabled.
    """

    email: EmailStr | None = None
    full_name: str | None = Field(default=None, min_length=1, max_length=200)
    is_active: bool | None = None


class PasswordChange(BaseModel):
    """What a client sends to replace its own password.

    Attributes:
        current_password: The password in force now. Bounded above but not
            below, for the reason :class:`~app.modules.sessions.schemas.SignIn`
            gives: a password stored before the minimum rose must still be
            usable to replace itself, and a 422 here would lock the account out
            of its own recovery.
        new_password: The replacement, held to the same rules as on create.
    """

    current_password: str = Field(max_length=PASSWORD_MAX_LENGTH)
    new_password: str = Field(min_length=PASSWORD_MIN_LENGTH, max_length=PASSWORD_MAX_LENGTH)


class UserRead(BaseModel):
    """What the API returns for a user. Note the absence of any password field.

    Attributes:
        pid: The public identifier, the one a URL names. The primary key is
            never returned.
        email: The user's address.
        full_name: Display name.
        is_active: Whether the account is enabled.
        created_at: Server-side timestamp, always UTC-aware.
        updated_at: Server-side timestamp, always UTC-aware.
    """

    model_config = ConfigDict(from_attributes=True)

    pid: UUID
    email: EmailStr
    full_name: str
    is_active: bool
    created_at: datetime
    updated_at: datetime


class Profile(BaseModel):
    """What a caller sees of their own account.

    Carries the ``pid`` and never the primary key. A client that stored only
    its credentials has no other way to learn the identifier its own account
    routes take — ``PUT /users/{pid}/password`` is the owner's alone, and the
    owner has to be able to reach it — and a ``pid`` is public by design: a
    random value that says nothing about the row behind it. The routes for the
    caller's own things that need no identifier, ``/items``, still take none.

    Attributes:
        pid: The caller's public identifier, as the account routes take it.
        email: The caller's address.
        full_name: Display name.
        is_active: Whether the account is enabled.
        created_at: When the account was created, UTC-aware.
    """

    model_config = ConfigDict(from_attributes=True)

    pid: UUID
    email: EmailStr
    full_name: str
    is_active: bool
    created_at: datetime


__all__ = ["PasswordChange", "Profile", "UserCreate", "UserRead", "UserUpdate"]
