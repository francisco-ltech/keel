"""Alembic's environment, wired for an async driver.

Two details matter here and both are easy to get wrong.

**The engine is async, so migrations run through ``run_sync``.** Alembic's
migration context is synchronous; ``connection.run_sync(...)`` hands it a
synchronous facade over the async connection. Pointing Alembic at a synchronous
driver instead would work, but it means two URLs in the configuration that can
drift apart.

**``target_metadata`` is Keel's, not a fresh ``MetaData``.** Every model in this
application inherits :class:`keel.database.Model`, so they all register on that
one object — which is also what carries the naming convention that makes
autogenerated constraint names deterministic. The models are imported below for
their side effect of registering; without those imports autogenerate produces an
empty migration and cheerfully reports success.
{% if has_worker %}
**Keel's own tables are imported for the same reason, and the failure mode is
worse.** ``FailedJob`` and ``ScheduleRun`` live in the library but register on
the same ``Model.metadata``. Leave them out and they are not merely absent from
the comparison — autogenerate sees two tables in the database that no model
claims and proposes ``DROP TABLE`` on both. Applying that diff deletes the
dead-letter record and the scheduler's exactly-once ledger, and the migration
looks like routine cleanup in review. Every new domain model needs a line below;
these two need one too.
{% endif %}"""

from __future__ import annotations

import asyncio
from logging.config import fileConfig

from alembic import context
from keel.database import Model
{%- if has_worker %}

# Not decoration: without these two, autogenerate proposes dropping
# `keel_failed_jobs` and `keel_schedule_runs`. See the module docstring.
from keel.queue import FailedJob, ScheduleRun  # noqa: F401  (registers the tables)
{%- endif %}
from sqlalchemy import Connection, pool
from sqlalchemy.ext.asyncio import create_async_engine

from app.modules.items.models import Item  # noqa: F401  (registers the table)
from app.modules.password_resets.models import PasswordReset  # noqa: F401  (registers the table)
from app.modules.users.models import User  # noqa: F401  (registers the table)
from app.settings import get_settings

config = context.config

if config.config_file_name is not None:
    fileConfig(config.config_file_name)

target_metadata = Model.metadata
"""What autogenerate compares the live database against."""

DATABASE_URL = get_settings().db.url
"""Read from the application's settings rather than from ``alembic.ini``, so
there is exactly one place the database URL is configured."""


def run_migrations_offline() -> None:
    """Emit SQL to stdout without connecting to anything.

    Useful when a DBA applies the change, or in a review where the generated SQL
    is the artefact being discussed.
    """
    context.configure(
        url=DATABASE_URL,
        target_metadata=target_metadata,
        literal_binds=True,
        dialect_opts={"paramstyle": "named"},
        compare_type=True,
        compare_server_default=True,
    )
    with context.begin_transaction():
        context.run_migrations()


def do_run_migrations(connection: Connection) -> None:
    """Run the migrations on an already-open synchronous connection.

    Args:
        connection: The synchronous facade handed over by ``run_sync``.
    """
    context.configure(
        connection=connection,
        target_metadata=target_metadata,
        # Both default to off, and both off means a column whose type or default
        # changed autogenerates an empty migration.
        compare_type=True,
        compare_server_default=True,
    )
    with context.begin_transaction():
        context.run_migrations()


async def run_async_migrations() -> None:
    """Open an async engine, run the migrations, and dispose of it.

    ``NullPool`` because a migration run is a single connection for a single
    process that is about to exit; pooling would only delay that exit.
    """
    engine = create_async_engine(DATABASE_URL, poolclass=pool.NullPool)
    try:
        async with engine.connect() as connection:
            await connection.run_sync(do_run_migrations)
    finally:
        await engine.dispose()


def run_migrations_online() -> None:
    """Entry point for a normal migration run.

    ``app.migrate`` — what the containers and ``just migrate`` run — takes
    Keel's advisory lock and hands the connection in through
    ``config.attributes``, Alembic's recipe for programmatic use. Honouring it
    is what makes two replicas migrating at once one migration and one wait;
    opening a second engine here would silently run outside the lock. The
    bare ``alembic`` command still works, unlocked, for a single developer.
    """
    connection = config.attributes.get("connection")
    if connection is not None:
        do_run_migrations(connection)
    else:
        asyncio.run(run_async_migrations())


if context.is_offline_mode():
    run_migrations_offline()
else:
    run_migrations_online()
