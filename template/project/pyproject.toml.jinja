[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = [
    # Where Keel comes from is `[tool.uv.sources]` below. The extras track the
    # shape — `auth` pulls in Argon2, `queue` the worker runtime SAQ.
    "keel[auth,postgres,metrics{% if has_worker %},queue{% endif %}]",
{%- if has_api %}
    "fastapi>=0.115",
{%- endif %}
    "pydantic[email]>=2.9",
    "pydantic-settings>=2.5",
    "alembic>=1.13",
    "asyncpg>=0.30",
{%- if has_api %}
    "uvicorn[standard]>=0.30",
{%- endif %}
    # `to_thread.run_sync` keeps Argon2 off the event loop{% if has_worker %}, and the worker's
    # task group and signal handling are here too{% endif %}. Asked for, not inherited.
    "anyio>=4.0",
]

[dependency-groups]
dev = [
    "pytest>=8.0",
    "anyio>=4.0",
{%- if has_api %}
    "httpx>=0.27",
{%- endif %}
    "ruff>=0.6",
    "mypy>=1.11",
    # Two type checkers: ty is fast enough for every save, mypy is slower but stable.
    # ty is pre-1.0, so it informs rather than gates. Drop one when you have a view.
    "ty>=0.0.80",
]

[tool.uv]
# Not a distribution — it is run from this directory, never installed. `app` is
# importable because the project root is on the path (`pythonpath` below).
package = false

[tool.uv.sources]
{%- if keel_source == "path" %}
# A local checkout, editable: a change under src/keel is live here at once.
keel = { path = "{{ keel_path }}", editable = true }
{%- else %}
# Pinned to the commit this scaffold was generated from, so the library and the
# template never disagree. `keel update` moves both together.
keel = { git = "{{ keel_repository }}", rev = "{{ _copier_conf.vcs_ref_hash }}" }
{%- endif %}

# ---------------------------------------------------------------- ruff
# Mirrors the Keel workspace, so generated code meets the library's standard.

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "F",    # pyflakes
    "W",    # pycodestyle warnings
    "I",    # isort
    "N",    # pep8-naming
    "UP",   # pyupgrade
    "B",    # flake8-bugbear
    "A",    # flake8-builtins
    "C4",   # flake8-comprehensions
    "SIM",  # flake8-simplify
    "TC",   # flake8-type-checking
    "BLE",  # flake8-blind-except
    "RUF",  # ruff-specific
    "ANN",  # flake8-annotations
    "D",    # pydocstyle
]
ignore = [
    "D107",    # undocumented __init__ (documented on the class instead)
    "ANN401",  # `Any` is sometimes the honest type
    # Annotations must stay resolvable at runtime: FastAPI and Pydantic build
    # schemas from them, so a deferred import is a NameError at schema build time.
    "TC001",
    "TC003",
]

[tool.ruff.lint.isort]
known-first-party = ["app", "tests"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.per-file-ignores]
# TC: nothing introspects a test module's annotations, so deferring imports
# there buys nothing and costs readability.
"tests/**/*.py" = ["D", "ANN", "S101", "TC"]
# Alembic writes these; they are generated artefacts, not hand-maintained code.
"app/migrations/versions/*.py" = ["D", "ANN", "E501", "I", "UP"]

# ---------------------------------------------------------------- ty

[tool.ty.src]
include = ["app", "tests"]

[tool.ty.environment]
python-version = "{{ python_version }}"

# ---------------------------------------------------------------- mypy

[tool.mypy]
python_version = "{{ python_version }}"
strict = true
warn_unreachable = true
disallow_any_generics = true
no_implicit_reexport = true
show_error_codes = true
plugins = ["pydantic.mypy"]
# `tests` has no __init__.py, so without these mypy maps tests/conftest.py to
# both `conftest` and `tests.conftest` and refuses to continue.
mypy_path = "."
explicit_package_bases = true
namespace_packages = true
# Generated migration scripts are not hand-written code and each one is a
# top-level module with a hash for a name, which mypy cannot resolve as a package.
exclude = ["^app/migrations/versions/"]

[[tool.mypy.overrides]]
module = "tests.*"
disallow_untyped_defs = false
disallow_incomplete_defs = false

# ---------------------------------------------------------------- pytest

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
addopts = "-q --strict-markers --strict-config"
