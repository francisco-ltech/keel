# {{ project_name }} configuration.
#
# Copy to `.env`; pydantic-settings reads it automatically. Everything here has
# a working default in app/settings.py, so an empty `.env` is a valid one.
#
# Settings are namespaced per subsystem, and each subsystem carries its own
# prefix rather than a nested delimiter: `DATABASE_URL` maps to `settings.db.url`
# and `QUEUE_DRIVER` to `settings.queue.driver`. Adding a subsystem means a new
# `<SUBSYSTEM>_*` block rather than new top-level keys.
{%- if has_worker %}
#
# Every variable here is read by both entrypoints. {% if has_api %}The API process and the
# worker process{% else %}A worker process and the API process it may be deployed beside{% endif %} share
# one configuration file, because they are one service.
{%- endif %}

# -- application ----------------------------------------------------------

APP_NAME={{ project_name }}
DEBUG=false

# -- database -------------------------------------------------------------
# Must name an async driver; Keel refuses a synchronous one at load time.

DATABASE_URL=postgresql+asyncpg://keel:keel@localhost:{{ postgres_port }}/keel
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Seconds. A cap means one pathological query fails instead of starving the pool
# behind it. Blank or `none` leaves the server default.
DB_STATEMENT_TIMEOUT=30

# -- cache ----------------------------------------------------------------
# `redis`, `array` (in-process) or `null` (retains nothing).

CACHE_STORE=redis
# Never empty on a shared Redis: an unnamespaced store's flush() takes every
# other application's keys with it.
CACHE_PREFIX={{ project_slug }}
REDIS_URL=redis://localhost:{{ redis_port }}/0
CACHE_TTL=300
{%- if has_worker %}

# -- queue ----------------------------------------------------------------

# `saq` (Redis, a real worker), `sync` (inline, no worker) or `null` (discards).
# Both entrypoints read it; the connection URL is the REDIS_URL above.

QUEUE_DRIVER=saq
# Never empty on a shared Redis, for the same reason CACHE_PREFIX is not:
# administrative operations would otherwise reach another application's keys.
QUEUE_PREFIX={{ project_slug }}
# Jobs one worker process runs at once. Capped in practice by DB_POOL_SIZE: most
# jobs open a transaction, and more jobs than connections only queue for one.
QUEUE_CONCURRENCY=10

# -- worker ---------------------------------------------------------------

# No HTTP here, so readiness is a file the worker keeps fresh plus an exec probe
# (`python -m app.healthcheck`). Keep it container-local, not on a shared volume.

WORKER_HEALTH_FILE=/tmp/{{ project_slug }}-worker.health
# Seconds of staleness the probe tolerates. Well above the worker's 5s refresh
# so one slow tick is not an outage.
WORKER_HEALTH_MAX_AGE=30
{%- endif %}
