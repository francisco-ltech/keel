# {{ project_name }} configuration.
#
# Copy to `.env`; pydantic-settings reads it automatically. Everything here has
# a working default in app/settings.py, so an empty `.env` is a valid one.
#
# Settings are namespaced per subsystem, and each subsystem carries its own
# prefix rather than a nested delimiter: `DATABASE_URL` maps to `settings.db.url`
# and `HASHING_TIME_COST` to `settings.hashing.time_cost`. Adding a subsystem means a new
# `<SUBSYSTEM>_*` block rather than new top-level keys.
{%- if has_worker %}
#
# Every variable here is read by both entrypoints. {% if has_api %}The API process and the
# worker process{% else %}A worker process and the API process it may be deployed beside{% endif %} share
# one configuration file, because they are one service.
{%- endif %}

# -- application ----------------------------------------------------------

APP_NAME={{ project_name }}
DEBUG=false
# Prometheus counters by route template, operation and job name{% if has_api %}, served at /metrics{% endif %}.
METRICS_ENABLED=true

# -- database -------------------------------------------------------------
# Must name an async driver; Keel refuses a synchronous one at load time.

DATABASE_URL=postgresql+asyncpg://keel:keel@localhost:{{ postgres_port }}/keel
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Seconds. A cap means one pathological query fails instead of starving the pool
# behind it. Blank or `none` leaves the server default.
DB_STATEMENT_TIMEOUT=30

# -- cache ----------------------------------------------------------------
# `redis`, `array` (in-process) or `null` (retains nothing).

CACHE_STORE=redis
# A sibling namespace, never a parent of another subsystem's: flush() scans this
# whole prefix, so `{{ project_slug }}` alone would delete {% if has_worker %}queued jobs{% if has_api %} and tokens{% endif %}{% else %}every token{% endif %}.
CACHE_PREFIX={{ project_slug }}:cache
REDIS_URL=redis://localhost:{{ redis_port }}/0
CACHE_TTL=300

# -- password hashing -----------------------------------------------------

# Argon2id cost. The defaults are the recommended set and take tens of
# milliseconds on purpose; turn them down in a test environment, never here.

HASHING_TIME_COST=3
HASHING_MEMORY_COST=65536
HASHING_PARALLELISM=4

# -- logging --------------------------------------------------------------

# `json` is one object per line for an aggregator, `text` the readable form for a
# terminal. Either way every line carries the request id in effect when written.

LOG_LEVEL=INFO
LOG_FORMAT=json
{%- if has_api %}

# -- request inspector ----------------------------------------------------
# While DEBUG=true, every request's queries, cache calls, dispatches and log
# lines are kept in memory and served at /_inspector/requests. DEBUG is the
# switch; these only say how much to keep and whether SQL parameters are in it.

INSPECTOR_RETAIN=100
INSPECTOR_PARAMETERS=false

# -- bearer tokens --------------------------------------------------------

# `redis` (survives a restart, shared by every replica) or `memory` (one
# process, everyone signed out on restart). `fake` is a test recorder, refused.

TOKEN_DRIVER=redis
# A sibling of CACHE_PREFIX{% if has_worker %} and QUEUE_PREFIX{% endif %} rather than a child of {% if has_worker %}either{% else %}it{% endif %}, so
# no subsystem's administrative operations reach another's keys.
TOKEN_PREFIX={{ project_slug }}:tokens
# Seconds, or `never` for a token that does not expire. Fourteen days: long
# enough not to sign people out mid-week, short enough that a stolen one lapses.
TOKEN_TTL=1209600
{%- endif %}
{%- if has_worker %}

# -- queue ----------------------------------------------------------------

# `saq` (Redis, a real worker), `sync` (inline, no worker) or `null` (discards).
# Both entrypoints read it; the connection URL is the REDIS_URL above.

QUEUE_DRIVER=saq
# A sibling of CACHE_PREFIX, never nested inside it: the cache's flush() scans
# its whole prefix, and a queue underneath it loses every pending job.
QUEUE_PREFIX={{ project_slug }}:queue
# Jobs one worker process runs at once. Capped in practice by DB_POOL_SIZE: most
# jobs open a transaction, and more jobs than connections only queue for one.
QUEUE_CONCURRENCY=10

# -- worker ---------------------------------------------------------------

# No HTTP here, so liveness is a file the worker keeps fresh plus an exec probe
# (`python -m app.healthcheck`). Keep it container-local, not on a shared volume.

WORKER_HEALTH_FILE=/tmp/{{ project_slug }}-worker.health
# Seconds of staleness the probe tolerates. Well above the worker's 5s refresh
# so one slow tick is not an outage.
WORKER_HEALTH_MAX_AGE=30
# The worker's scrape port. 0 opens nothing; a scraper on the pod network sets it.
WORKER_METRICS_PORT=0
{%- endif %}
