# {{ project_name }}
#
# `just` with no arguments lists everything; `just check` runs the full gate.

# Recipes run through `sh` where there is one and PowerShell where there is
# not, so every recipe here is a plain command that both accept.
set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

# Show the available recipes.
default:
    @just --list --unsorted

# Create the virtualenv and install everything, including dev tools.
install:
    uv sync

# Start Postgres, Redis and Mailpit.
up:
    docker compose up -d

# Run the application the way it deploys: in containers next to Postgres,
# Redis and Mailpit, from this directory mounted in. One recipe on every OS — no shell
# script, no process supervision on the host — and the API reloads on change.
dev:
    docker compose --profile app up

# Stop everything `up` or `dev` started, keeping the volumes.
down:
    docker compose --profile app down
{% if has_api %}
# `--no-access-log` because app/observability.py already writes one line per
# request, in the configured format and carrying the request id. Uvicorn's is
# the same fact in a second shape, which is one line per request to ignore.

# Run the API on the host instead, for a debugger or a faster reload loop.
serve:
    uv run uvicorn app.main:app --reload --port 8000 --no-access-log
{% endif %}{% if has_worker %}
# Run the worker: consumes jobs, runs the schedule, writes its heartbeat file.
worker:
    uv run python -m app.worker

# Ask the worker's exec probe whether it is alive. Exit status is the answer.
health:
    uv run python -m app.healthcheck
{% endif %}
# Run the suite. Needs Postgres; each test runs in a transaction that is rolled back.
test *ARGS:
    uv run pytest {{ '{{' }} ARGS {{ '}}' }}

# Check formatting and lint rules.
lint:
    uv run ruff check .
    uv run ruff format --check .

# Apply formatting and the safe fixes.
fmt:
    uv run ruff format .
    uv run ruff check --fix .

# Type-check with ty. Fast enough to run on every save.
types:
    uv run ty check app tests

# Type-check with mypy --strict. Slower, and what CI gates on.
types-mypy:
    uv run mypy app tests

# Apply every pending migration, under the advisory lock the containers use too.
migrate:
    uv run python -m app.migrate

# Autogenerate a migration: just revision "add widgets"
revision MESSAGE:
    uv run alembic revision --autogenerate -m "{{ '{{' }} MESSAGE {{ '}}' }}"

# Everything CI runs. Do this before you push.
check: lint types types-mypy test
