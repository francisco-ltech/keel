# Local services for {{ project_name }}.
#
# The published ports are {{ postgres_port }} and {{ redis_port }} rather than the defaults, because
# 5432 and 6379 are usually already taken on a development machine. If the Keel
# workspace's own stack is already running on these ports, skip `just up` — the
# credentials below match it and the application will talk to that.

name: {{ project_slug }}

services:
  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: keel
      POSTGRES_PASSWORD: keel
      POSTGRES_DB: keel
    ports:
      - "{{ postgres_port }}:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      # A compose dependency on "started" only says the process launched;
      # Postgres refuses connections for a second or two after that.
      test: ["CMD-SHELL", "pg_isready -U keel -d keel"]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 10s

  redis:
    image: redis:7-alpine
    command: ["redis-server", "--appendonly", "yes"]
    ports:
      - "{{ redis_port }}:6379"
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 5s

  # Behind the `app` profile, so `just up` still starts only Postgres and Redis.
  # Deployment model and why there is no Dockerfile: see the README.
{%- if has_api %}

  api:
    profiles: ["app"]
    # The full image, not `-slim`, when Keel is a git dependency: uv needs git
    # inside the container to fetch it. A path-linked checkout needs no git.
    image: ghcr.io/astral-sh/uv:python{{ python_version }}-bookworm{% if keel_source == 'path' %}-slim{% endif %}
    working_dir: /srv/app
    # `--no-access-log`: app/observability.py writes that line itself, in the
    # configured format and with the request id on it.
    command:
      [
        "sh",
        "-c",
        "uv sync && uv run python -m app.migrate && exec uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --no-access-log",
      ]
    environment:
      UV_PROJECT_ENVIRONMENT: /opt/venv
      UV_LINK_MODE: copy
      DATABASE_URL: postgresql+asyncpg://keel:keel@postgres:5432/keel
      REDIS_URL: redis://redis:6379/0
    volumes:
      - .:/srv/app
      # The container's virtualenv, kept across restarts so `uv sync` is a no-op
      # the second time. Not `./.venv`: that holds host binaries.
      - api-venv:/opt/venv
{%- if keel_source == 'path' %}
      # Mounted at its host path so `[tool.uv.sources] keel = { path = ... }`
      # resolves to the same place inside the container as outside it.
      - {{ keel_path }}:{{ keel_path }}:ro
{%- endif %}
    ports:
      - "8000:8000"
    depends_on:
      postgres: {condition: service_healthy}
      redis: {condition: service_healthy}
{%- endif %}
{%- if has_worker %}

  worker:
    profiles: ["app"]
    # The full image, not `-slim`, when Keel is a git dependency: uv needs git
    # inside the container to fetch it. A path-linked checkout needs no git.
    image: ghcr.io/astral-sh/uv:python{{ python_version }}-bookworm{% if keel_source == 'path' %}-slim{% endif %}
    working_dir: /srv/app
    # Migrates first, like the API: app.migrate takes an advisory lock, so two
    # containers doing it at once is one migration and one wait.
    command: ["sh", "-c", "uv sync && uv run python -m app.migrate && exec uv run python -m app.worker"]
    environment:
      UV_PROJECT_ENVIRONMENT: /opt/venv
      UV_LINK_MODE: copy
      DATABASE_URL: postgresql+asyncpg://keel:keel@postgres:5432/keel
      REDIS_URL: redis://redis:6379/0
      QUEUE_DRIVER: saq
      WORKER_HEALTH_FILE: /tmp/{{ project_slug }}-worker.health
    volumes:
      - .:/srv/app
      - worker-venv:/opt/venv
{%- if keel_source == 'path' %}
      - {{ keel_path }}:{{ keel_path }}:ro
{%- endif %}
    healthcheck:
      # An **exec probe**, not HTTP: the worker serves no HTTP. `app.healthcheck`
      # exits 0 while the container-local heartbeat file is younger than its max age.
      test: ["CMD", "uv", "run", "python", "-m", "app.healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 3
      # Generous: the first `uv sync` in a cold container has to resolve and
      # install before the worker can write a heartbeat at all.
      start_period: 120s
    depends_on:
      postgres: {condition: service_healthy}
      redis: {condition: service_healthy}
{%- endif %}

volumes:
  postgres-data:
  redis-data:
{%- if has_api %}
  api-venv:
{%- endif %}
{%- if has_worker %}
  worker-venv:
{%- endif %}
