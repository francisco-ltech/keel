"""The queue half of the items domain.

Two questions, two tests, and keeping them apart is the point. "Did creating an
item enqueue the index job?" is answered with a recording fake that never runs
anything. "Does the index job work?" is answered by awaiting the handler
directly. Conflating them — a fake that runs what it records — produces a test
that fails for either reason and says which for neither.

None of this needs a worker, a Redis or an HTTP client. A job is an object with
a handler; the queue is what moves it between processes, and that part is
Keel's to test rather than this application's.

**Every call into a service names a caller**, with ``acting_as``. The services
authorize, so a test driving them directly is in the position a job handler is
in: no request, no header, and a rule that still has to be satisfied. That is
not test scaffolding to work around — it is the property being tested, and
``IndexItem.handle`` does exactly the same thing for itself.
"""

from __future__ import annotations

from uuid import UUID

import pytest
from keel.auth import Identity, acting_as, current_identity, use_policies
from keel.cache import cache
from keel.observability import correlate
from keel.queue import PermanentFailureError
from keel.testing import fake_mail, fake_queue

from app.errors import NotFoundError
from app.modules.items import service as items_service
from app.modules.items.jobs import IndexItem, card_key
from app.modules.items.schemas import ItemCreate
from app.modules.password_resets.jobs import SendResetCode
from app.modules.users.jobs import SendWelcome
from app.policies import ItemsOf
from tests.conftest import make_user, primary_key_of

pytestmark = pytest.mark.anyio

MISSING_ID = "00000000-0000-4000-8000-000000000000"


async def test_creating_an_item_dispatches_the_index_job(rolled_back: None) -> None:
    owner = await make_user()
    owner_id = await primary_key_of(owner)

    with fake_queue() as queued, acting_as(Identity(id=owner_id)):
        item = await items_service.create_item(owner_id, ItemCreate(name="Engine"))

    queued.assert_pushed(IndexItem, item_pid=str(item.pid), owner_id=str(owner_id))


async def test_the_dispatch_carries_the_request_id_to_the_worker(rolled_back: None) -> None:
    """The half of the join that happens in this process.

    `app/observability.py` binds the id for the request; `dispatch()` seals
    whatever is bound onto the envelope; Keel's worker binds it again around the
    handler. This pins the middle step — the one that is invisible until someone
    goes looking for a worker log line and finds nothing to search by.
    """
    owner = await make_user()
    owner_id = await primary_key_of(owner)

    identity = Identity(id=owner_id)
    with fake_queue() as queued, acting_as(identity), correlate(request_id="req-from-the-api"):
        item = await items_service.create_item(owner_id, ItemCreate(name="Engine"))

    envelope = queued.assert_pushed(IndexItem, item_pid=str(item.pid))
    assert envelope.context["request_id"] == "req-from-the-api"


async def test_a_failed_creation_dispatches_nothing(rolled_back: None) -> None:
    """Nothing is enqueued for a row that was never written.

    The unit of work rejects the unknown owner, so the transaction never
    commits — and `dispatch()` inside a transaction holds the push until it
    does. A worker seeing this job would be emailing about an item that does
    not exist, and would usually win the race and dead-letter looking like
    corrupted data.
    """
    # Acting as the absent owner: the policy permits it, so the test reaches the
    # 404 it is about rather than stopping at a 403.
    with fake_queue() as queued, acting_as(Identity(id=UUID(MISSING_ID))):
        with pytest.raises(NotFoundError):
            await items_service.create_item(UUID(MISSING_ID), ItemCreate(name="Orphan"))

        queued.assert_nothing_pushed()


async def test_the_index_job_caches_a_card(rolled_back: None) -> None:
    owner = await make_user()
    owner_id = await primary_key_of(owner)
    with acting_as(Identity(id=owner_id)):
        item = await items_service.create_item(owner_id, ItemCreate(name="Engine"))

    await IndexItem(item_pid=str(item.pid), owner_id=str(owner_id)).handle()

    assert await cache.get(card_key(item.pid)) == {
        "pid": str(item.pid),
        "name": "Engine",
        "description": None,
    }


async def test_the_index_job_is_idempotent(rolled_back: None) -> None:
    """At-least-once is the only delivery guarantee, so running twice must be safe."""
    owner = await make_user()
    owner_id = await primary_key_of(owner)
    with acting_as(Identity(id=owner_id)):
        item = await items_service.create_item(owner_id, ItemCreate(name="Engine"))
    job = IndexItem(item_pid=str(item.pid), owner_id=str(owner_id))

    await job.handle()
    await job.handle()

    assert await cache.get(card_key(item.pid)) is not None


async def test_indexing_a_deleted_item_stops_retrying(rolled_back: None) -> None:
    """The error taxonomy, from the worker's side.

    The service raises the same `NotFoundError` a router turns into a 404. The
    handler classifies it as permanent, so the worker dead-letters it now
    instead of spending five attempts and an hour of backoff re-reading a row
    that was deleted on purpose.
    """
    owner = await make_user()
    owner_id = await primary_key_of(owner)

    with pytest.raises(PermanentFailureError):
        await IndexItem(item_pid=MISSING_ID, owner_id=str(owner_id)).handle()


async def test_another_owners_item_is_permanently_unindexable(rolled_back: None) -> None:
    """The job asks the scoped question, so it cannot read across owners."""
    ada = await make_user(email="ada@example.com")
    ada_id = await primary_key_of(ada)
    grace = await make_user(email="grace@example.com")
    grace_id = await primary_key_of(grace)
    with acting_as(Identity(id=ada_id)):
        item = await items_service.create_item(ada_id, ItemCreate(name="Engine"))

    with pytest.raises(PermanentFailureError):
        await IndexItem(item_pid=str(item.pid), owner_id=str(grace_id)).handle()


async def test_the_job_runs_with_the_owners_authority_and_no_more(rolled_back: None) -> None:
    """`handle` publishes its own caller, and it is the payload's owner.

    Two claims in one test. The handler needs no ambient identity — nothing is
    bound when it is awaited here, exactly as in a worker — and the identity it
    builds carries no roles, so a job can never reach further than the person it
    acts for. The second half is what stops a queue becoming an escalation path.
    """
    ada = await make_user(email="ada@example.com")
    ada_id = await primary_key_of(ada)
    with acting_as(Identity(id=ada_id)):
        item = await items_service.create_item(ada_id, ItemCreate(name="Engine"))

    await IndexItem(item_pid=str(item.pid), owner_id=str(ada_id)).handle()

    assert current_identity() is None, "the job leaked its caller into the process"
    assert await cache.get(card_key(item.pid)) is not None


async def test_a_job_acts_with_no_roles(rolled_back: None) -> None:
    """The ceiling on a job's authority, which nothing else observes.

    The test above asserts the job names a caller and clears it afterwards.
    Neither half looks at roles — so granting the handler `admin` left the whole
    suite green, and the queue would have become an escalation path. This
    captures the identity the policy is actually asked about.
    """
    ada = await make_user(email="ada@example.com")
    ada_id = await primary_key_of(ada)
    with acting_as(Identity(id=ada_id)):
        item = await items_service.create_item(ada_id, ItemCreate(name="Engine"))

    seen: list[Identity | None] = []

    def capture(identity: Identity | None, action: str, resource: ItemsOf) -> bool:
        seen.append(identity)
        return True

    with use_policies() as policies:
        policies.register(ItemsOf, capture)
        await IndexItem(item_pid=str(item.pid), owner_id=str(ada_id)).handle()

    assert seen, "the job never consulted a policy"
    assert all(who is not None and who.roles == frozenset() for who in seen), (
        "a job reached further than the person it acts for"
    )


# -- the welcome job ------------------------------------------------------------


async def test_the_welcome_job_sends_to_the_accounts_current_address(rolled_back: None) -> None:
    owner = await make_user(email="ada@example.com", full_name="Ada Lovelace")

    with fake_mail() as outbox:
        await SendWelcome(user_pid=str(owner.pid)).handle()

    sent = outbox.assert_sent(to="ada@example.com", subject_contains="Welcome")
    assert "Ada Lovelace" in sent.text


async def test_welcoming_a_deleted_account_stops_retrying(rolled_back: None) -> None:
    with fake_mail() as outbox, pytest.raises(PermanentFailureError):
        await SendWelcome(user_pid=MISSING_ID).handle()
    outbox.assert_nothing_sent()


# -- the reset-code job ---------------------------------------------------------


async def test_the_reset_job_mails_the_code_to_the_account(rolled_back: None) -> None:
    owner = await make_user(email="ada@example.com", full_name="Ada Lovelace")

    with fake_mail() as outbox:
        await SendResetCode(user_pid=str(owner.pid), code="the-code").handle()

    sent = outbox.assert_sent(to="ada@example.com", subject_contains="Reset")
    assert "the-code" in sent.text
    assert sent.html is not None and "the-code" in sent.html


async def test_resetting_a_deleted_account_stops_retrying(rolled_back: None) -> None:
    with fake_mail() as outbox, pytest.raises(PermanentFailureError):
        await SendResetCode(user_pid=MISSING_ID, code="the-code").handle()
    outbox.assert_nothing_sent()
