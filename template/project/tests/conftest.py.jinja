from keel.database import Database, Model, current_database, database_lifespan
{%- if has_worker %}
from keel.queue import queue_lifespan
{%- endif %}
from keel.testing import rolled_back_database

{% if has_api -%}
from app.main import create_app
{% endif -%}
from app.modules.users import service as users_service
from app.modules.users.schemas import UserCreate, UserRead
from app.settings import CacheSettings, {% if has_worker %}QueueSettings, {% endif %}Settings

DEFAULT_USER = {
    "email": "ada@example.com",
    "full_name": "Ada Lovelace",
    "password": "correct-horse-battery",
}
"""One valid user, for tests that need one and do not care about its contents."""


@pytest.fixture(scope="session")
def anyio_backend() -> str:
    """Run async tests on asyncio only."""
    return "asyncio"


@pytest.fixture(scope="session")
def settings() -> Settings:
    """Settings for the suite: the real database, an in-process cache{% if has_worker %}, no queue{% endif %}."""
    base = Settings()
    overrides: dict[str, Any] = {
        "cache": CacheSettings(store="array", prefix="test", default_ttl=60.0)
    }
{%- if has_worker %}
    overrides["queue"] = QueueSettings(driver="null")
{%- endif %}
    return base.model_copy(update=overrides)


@pytest.fixture(scope="session", autouse=True)
def _schema(settings: Settings) -> None:
    """Make sure the tables exist before anything tries to use them.

    ``create_all`` is a no-op when ``alembic upgrade head`` has already run, so
    this is a convenience for a fresh checkout rather than a second source of
    truth for the schema. Migrations remain the thing that is deployed.
{%- if has_worker %}

    ``Model.metadata`` includes Keel's ``keel_failed_jobs`` and
    ``keel_schedule_runs``, because ``app.migrations.env`` imports them — so a
    test that dead-letters a job finds a table to write to.
{%- endif %}
    """

    async def create() -> None:
        database = Database(settings.database_config())
        try:
            async with database.engine.begin() as connection:
                await connection.run_sync(Model.metadata.create_all)
        finally:
            await database.close()

    anyio.run(create)


@pytest.fixture
async def runtime(settings: Settings) -> AsyncIterator[None]:
    """Bind the subsystems with no HTTP in front of them.

    The same {% if has_worker %}three{% else %}two{% endif %} lifespans {% if has_worker %}``app.worker.serve``{% else %}``app.main``{% endif %} opens, in the same order.
    A test using this fixture is running in the environment a {% if has_worker %}worker{% else %}management
    command{% endif %} lives in.
    """
    async with (
        database_lifespan(settings.database_config()),
        cache_lifespan(settings.cache_config()),
{%- if has_worker %}
        queue_lifespan(settings.queue_config()),
{%- endif %}
    ):
        yield


@pytest.fixture
async def rolled_back(runtime: None) -> AsyncIterator[None]:
    """Undo everything the test wrote, without an application in the way."""
    async with rolled_back_database(current_database()):
        yield


async def make_user(**overrides: str) -> UserRead:
    """Create a user through the service layer.

    The seam a job handler drives, so a queue test needs no HTTP client{% if has_api %} — and
    the HTTP `create_user` below stays the one that exercises the router{% endif %}.
    Requires a bound database: use it with the ``rolled_back`` fixture.

    Args:
        **overrides: Fields to change on :data:`DEFAULT_USER`.

    Returns:
        The created user.
    """
    return await users_service.create_user(UserCreate(**(DEFAULT_USER | overrides)))
{% if has_api %}

@pytest.fixture
async def app(settings: Settings) -> AsyncIterator[FastAPI]:
    """An application driven through its real lifespan.

    Entering the lifespan is what binds the database and the cache; a test that
    skips it gets a ``ConfigurationError`` from the first ``uow()`` rather than a
    mysterious ``None``.
    """
    application = create_app(settings)
    async with application.router.lifespan_context(application):
        yield application


@pytest.fixture
async def client(app: FastAPI) -> AsyncIterator[AsyncClient]:
    """An HTTP client whose every request is undone when the test ends."""
    async with rolled_back_database(current_database()):
        transport = ASGITransport(app=app)
        async with AsyncClient(transport=transport, base_url="http://test") as http:
            yield http


@pytest.fixture
def user_payload() -> dict[str, str]:
    """A valid user, for tests that need one and do not care about its contents."""
    return dict(DEFAULT_USER)


async def create_user(client: AsyncClient, **overrides: str) -> dict[str, str]:
    """Create a user through the API and return the response body.

    Args:
        client: The HTTP client.
        **overrides: Fields to change on :data:`DEFAULT_USER`.

    Returns:
        The created user.
    """
    response = await client.post("/users", json=DEFAULT_USER | overrides)
    assert response.status_code == 201, response.text
    body: dict[str, str] = response.json()
    return body
{% endif -%}
