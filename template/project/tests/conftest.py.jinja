async def create_user(client: AsyncClient, **overrides: str) -> dict[str, str]:
    """Create a user through the API and return the response body.

    Args:
        client: The HTTP client.
        **overrides: Fields to change on :data:`DEFAULT_USER`.

    Returns:
        The created user.
    """
    response = await client.post("/users", json=DEFAULT_USER | overrides)
    assert response.status_code == 201, response.text
    body: dict[str, str] = response.json()
    return body


async def signed_in(client: AsyncClient, **overrides: str) -> tuple[dict[str, str], str]:
    """Create a user, sign them in, and return both halves.

    Most routes under ``/users`` need a caller *and* the record's pid, and
    fetching the pid back needs the token — so handing over both is what stops
    every test starting with the same four lines.

    Args:
        client: The HTTP client.
        **overrides: Fields to change on :data:`DEFAULT_USER`.

    Returns:
        The created user, and a token for them.
    """
    payload = DEFAULT_USER | overrides
    created = await create_user(client, **overrides)
    response = await client.post(
        "/sessions", json={"email": payload["email"], "password": payload["password"]}
    )
    assert response.status_code == 201, response.text
    token: str = response.json()["access_token"]
    return created, token


async def sign_in(client: AsyncClient, **overrides: str) -> str:
    """Create a user, sign them in, and return the bearer token.

    Args:
        client: The HTTP client.
        **overrides: Fields to change on :data:`DEFAULT_USER`.

    Returns:
        The token, ready for an ``Authorization`` header.
    """
    _, token = await signed_in(client, **overrides)
    return token


def bearer(token: str) -> dict[str, str]:
    """Build the header a signed-in client sends.

    Args:
        token: The token from :func:`sign_in`.

    Returns:
        The ``Authorization`` header.
    """
    return {"Authorization": f"Bearer {token}"}


async def admin_bearer() -> dict[str, str]:
    """Mint a token for a caller holding the ``admin`` role.

    Nothing in this scaffold *issues* roles: ``sign_in`` builds an ``Identity``
    with none, because this domain has no column or table to read them from. So
    an administrator is made here exactly the way an application that had one
    would make it — the roles go onto the ``Identity`` at the moment the token
    is minted, and the store carries them to every later request. Swap this for
    your own source and every rule in ``app/policies.py`` starts applying.

    Needs the token store bound, so call it from a test using the ``client``
    fixture. The identity matches no user row, which is the point: an admin
    acting on somebody else's resource is not that resource's owner.

    Returns:
        The ``Authorization`` header for an administrator.
    """
    issued = await issue_token(Identity(id=uuid4(), roles=frozenset({"admin"})))
    return bearer(issued.plaintext)
