    base = Settings()
    overrides: dict[str, Any] = {
        "cache": CacheSettings(store="array", prefix="test:cache", default_ttl=60.0),
        "hashing": HashingSettings(time_cost=1, memory_cost=MINIMUM_MEMORY_COST, parallelism=1),
    }
{%- if has_api %}
