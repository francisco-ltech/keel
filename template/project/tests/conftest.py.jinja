    overrides["token"] = TokenSettings(driver="memory", prefix="test:tokens")
{%- endif %}
{%- if has_worker %}
    overrides["queue"] = QueueSettings(driver="null")
{%- endif %}
    return base.model_copy(update=overrides)


@pytest.fixture(scope="session", autouse=True)
def _schema(settings: Settings) -> None:
    """Make sure the tables exist before anything tries to use them.

    ``create_all`` is a no-op when ``alembic upgrade head`` has already run, so
    this is a convenience for a fresh checkout rather than a second source of
    truth for the schema. Migrations remain the thing that is deployed.
{%- if has_worker %}

    ``Model.metadata`` includes Keel's ``keel_failed_jobs`` and
    ``keel_schedule_runs``, because ``app.migrations.env`` imports them — so a
    test that dead-letters a job finds a table to write to.
{%- endif %}
    """

    async def create() -> None:
        database = Database(settings.database_config())
        try:
            async with database.engine.begin() as connection:
                await connection.run_sync(Model.metadata.create_all)
        finally:
            await database.close()

    anyio.run(create)


