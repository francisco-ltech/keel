"""Forgetting a password, and getting it back without leaking who has one.

The route pair answers 202 to every request and 204 or 422 to every
redemption, and the assertions here pin what the body never says: whether the
address exists, which of "unknown, expired or used" a code was, and whether a
message went out. The last is asserted through the {% if has_worker %}queue{% else %}outbox{% endif %}, which is the
only place it is observable.
"""

from __future__ import annotations

{% if not has_worker %}import re
{% endif %}from collections.abc import AsyncIterator
from datetime import timedelta
from uuid import UUID

import anyio
import pytest
from fastapi import FastAPI
from httpx import ASGITransport, AsyncClient
from keel.auth import PasswordHasher, use_password_hasher
from keel.database import uow, utcnow
{% if has_worker %}from keel.testing import fake_queue
{% else %}from keel.testing import fake_mail
{% endif %}from sqlalchemy import select, update

{% if has_worker %}from app.modules.password_resets.jobs import SendResetCode
{% endif %}from app.modules.password_resets.models import PasswordReset
from app.modules.password_resets.service import INVALID_CODE
from app.modules.users.repository import UserRepository
from app.settings import Settings
from tests.conftest import DEFAULT_USER, bearer, create_user, signed_in

pytestmark = pytest.mark.anyio

NEW_PASSWORD = "a-different-correct-horse"


async def request_code(client: AsyncClient, email: str) -> str | None:
    """Ask for a reset and return the code that went out, or None if nothing did."""
{% if has_worker %}
    with fake_queue() as queued:
        response = await client.post("/password-resets", json={"email": email})
    assert response.status_code == 202, response.text
    assert response.content == b""
    if not queued.pushed:
        return None
    envelope = queued.assert_pushed(SendResetCode)
    return str(envelope.payload["code"])
{% else %}
    with fake_mail() as outbox:
        response = await client.post("/password-resets", json={"email": email})
    assert response.status_code == 202, response.text
    assert response.content == b""
    if not outbox.sent:
        return None
    sent = outbox.assert_sent(to=email, subject_contains="Reset")
    found = re.search(r"^\s+(\S+)$", sent.text, re.MULTILINE)
    assert found is not None, sent.text
    return found.group(1)
{% endif %}

async def redeem(client: AsyncClient, code: str, password: str = NEW_PASSWORD) -> int:
    response = await client.post(
        "/password-resets/redeem", json={"code": code, "password": password}
    )
    return response.status_code


async def can_sign_in(client: AsyncClient, email: str, password: str) -> bool:
    response = await client.post("/sessions", json={"email": email, "password": password})
    return response.status_code == 201


async def backdate(**columns: object) -> None:
    """Rewrite the newest reset row, to age it past a window without waiting."""
    async with uow() as session:
        newest = (
            await session.scalars(select(PasswordReset).order_by(PasswordReset.created_at.desc()))
        ).first()
        assert newest is not None
        await session.execute(
            update(PasswordReset).where(PasswordReset.id == newest.id).values(**columns)
        )


async def test_requesting_a_reset_sends_a_code(client: AsyncClient) -> None:
    await create_user(client)

    code = await request_code(client, DEFAULT_USER["email"])

    assert code is not None and len(code) >= 32


async def test_an_unknown_address_answers_the_same_and_sends_nothing(client: AsyncClient) -> None:
    """The 202 and the empty body are the enumeration defence; the outbox is the proof."""
    assert await request_code(client, "nobody@example.com") is None


async def test_a_disabled_account_gets_no_code(client: AsyncClient) -> None:
    created = await create_user(client)
    async with uow() as session:
        users = UserRepository(session)
        row = await users.get_by_pid(UUID(created["pid"]))
        assert row is not None
        await users.update(row, {"is_active": False})

    assert await request_code(client, DEFAULT_USER["email"]) is None


async def test_a_second_request_inside_the_cooldown_sends_nothing(client: AsyncClient) -> None:
    """A flood reaches the mailbox once a minute, and the first code still works."""
    await create_user(client)

    first = await request_code(client, DEFAULT_USER["email"])
    second = await request_code(client, DEFAULT_USER["email"])

    assert first is not None
    assert second is None
    assert await redeem(client, first) == 204


async def test_redeeming_sets_the_password_and_signs_every_device_out(client: AsyncClient) -> None:
    created, token = await signed_in(client)
    code = await request_code(client, DEFAULT_USER["email"])
    assert code is not None

    assert await redeem(client, code) == 204

    assert not await can_sign_in(client, DEFAULT_USER["email"], DEFAULT_USER["password"])
    assert await can_sign_in(client, DEFAULT_USER["email"], NEW_PASSWORD)
    stale = await client.get(f"/users/{created['pid']}", headers=bearer(token))
    assert stale.status_code == 401, "the session from before the reset still worked"


async def test_a_code_works_once(client: AsyncClient) -> None:
    await create_user(client)
    code = await request_code(client, DEFAULT_USER["email"])
    assert code is not None

    assert await redeem(client, code) == 204
    assert await redeem(client, code, "yet-another-password") == 422
    assert await can_sign_in(client, DEFAULT_USER["email"], NEW_PASSWORD)


async def test_a_wrong_code_is_refused_without_saying_why(client: AsyncClient) -> None:
    await create_user(client)
    await request_code(client, DEFAULT_USER["email"])

    response = await client.post(
        "/password-resets/redeem", json={"code": "not-a-code", "password": NEW_PASSWORD}
    )

    assert response.status_code == 422
    assert response.headers["content-type"].startswith("application/problem+json")
    assert response.json()["detail"] == INVALID_CODE
    assert await can_sign_in(client, DEFAULT_USER["email"], DEFAULT_USER["password"])


async def test_an_expired_code_is_refused(client: AsyncClient) -> None:
    """Backdated well past the window: `now()` inside the test's transaction is its start time."""
    await create_user(client)
    code = await request_code(client, DEFAULT_USER["email"])
    assert code is not None
    await backdate(expires_at=utcnow() - timedelta(minutes=5))

    assert await redeem(client, code) == 422


async def test_a_successful_reset_retires_every_earlier_code(client: AsyncClient) -> None:
    """Two codes in flight, the later one used: the earlier one must not still open the account."""
    await create_user(client)
    first = await request_code(client, DEFAULT_USER["email"])
    await backdate(created_at=utcnow() - timedelta(minutes=5))
    second = await request_code(client, DEFAULT_USER["email"])
    assert first is not None and second is not None

    assert await redeem(client, second) == 204
    assert await redeem(client, first, "yet-another-password") == 422


async def test_the_code_is_stored_only_as_a_digest(client: AsyncClient) -> None:
    await create_user(client)
    code = await request_code(client, DEFAULT_USER["email"])
    assert code is not None

    async with uow() as session:
        rows = (await session.scalars(select(PasswordReset))).all()

    assert len(rows) == 1
    assert rows[0].code_digest != code
    assert len(rows[0].code_digest) == 64


async def test_a_client_gets_ten_requests_a_minute_whatever_the_address(
    client: AsyncClient,
) -> None:
    """The cooldown is per account; this is the limit on walking a list of addresses."""
    for n in range(10):
        response = await client.post("/password-resets", json={"email": f"user{n}@example.com"})
        assert response.status_code == 202

    refused = await client.post("/password-resets", json={"email": "user10@example.com"})

    assert refused.status_code == 429
    assert 1 <= int(refused.headers["retry-after"]) <= 60


async def test_an_invalid_code_is_refused_without_hashing(
    client: AsyncClient, settings: Settings
) -> None:
    """Argon2 is 40ms and 64 MiB per call, on a route with no caller to charge it to."""

    class Counting(PasswordHasher):
        calls = 0

        def hash(self, plaintext: str) -> str:
            Counting.calls += 1
            return super().hash(plaintext)

    with use_password_hasher(Counting(settings.hashing_config())):
        assert await redeem(client, "not-a-code") == 422

    assert Counting.calls == 0


async def test_changing_the_password_retires_outstanding_codes(client: AsyncClient) -> None:
    """A code mailed before the owner changed their password must not undo the change."""
    created, token = await signed_in(client)
    code = await request_code(client, DEFAULT_USER["email"])
    assert code is not None

    changed = await client.put(
        f"/users/{created['pid']}/password",
        json={"current_password": DEFAULT_USER["password"], "new_password": NEW_PASSWORD},
        headers=bearer(token),
    )

    assert changed.status_code == 204
    assert await redeem(client, code, "yet-another-password") == 422
    assert await can_sign_in(client, DEFAULT_USER["email"], NEW_PASSWORD)


# -- under concurrency, against committed rows ---------------------------------
#
# The `client` fixture wraps a test in one rolled-back transaction, which is
# the wrong instrument for a race: every request would share it. These two
# commit for real through the application's own pool and clean up after.


@pytest.fixture
async def committed(app: FastAPI) -> AsyncIterator[AsyncClient]:
    """A client whose requests commit, with every user it made deleted afterwards."""
    transport = ASGITransport(app=app)
    async with AsyncClient(transport=transport, base_url="http://test") as http:
        try:
            yield http
        finally:
            async with uow() as session:
                users = UserRepository(session)
                for email in (DEFAULT_USER["email"],):
                    row = await users.get_by_email(email)
                    if row is not None:
                        await users.delete(row)


async def test_the_cooldown_holds_against_concurrent_requests(committed: AsyncClient) -> None:
    """Twenty at once: the throttle lets ten through, the row lock lets one code out."""
    await create_user(committed)
    email = DEFAULT_USER["email"]
    statuses: list[int] = []

    async def one() -> None:
        response = await committed.post("/password-resets", json={"email": email})
        statuses.append(response.status_code)
{% if has_worker %}
    with fake_queue() as queued:
        async with anyio.create_task_group() as group:
            for _ in range(20):
                group.start_soon(one)
    assert len(queued.pushed) == 1, f"{len(queued.pushed)} codes went out"
{% else %}
    with fake_mail() as outbox:
        async with anyio.create_task_group() as group:
            for _ in range(20):
                group.start_soon(one)
    assert len(outbox.sent) == 1, f"{len(outbox.sent)} codes went out"
{% endif %}
    assert sorted(statuses) == [202] * 10 + [429] * 10
    async with uow() as session:
        rows = (await session.scalars(select(PasswordReset))).all()
    assert len(rows) == 1


async def test_two_codes_for_one_account_redeemed_at_once_do_not_deadlock(
    committed: AsyncClient,
) -> None:
    """Both want the account and every reset row; taking the account first gives them one order."""
    await create_user(committed)
    first = await request_code(committed, DEFAULT_USER["email"])
    await backdate(created_at=utcnow() - timedelta(minutes=5))
    second = await request_code(committed, DEFAULT_USER["email"])
    assert first is not None and second is not None
    statuses: list[int] = []

    async def one(code: str) -> None:
        statuses.append(await redeem(committed, code))

    async with anyio.create_task_group() as group:
        group.start_soon(one, first)
        group.start_soon(one, second)

    assert sorted(statuses) == [204, 422], statuses
