async def test_deleting_an_item(client: AsyncClient) -> None:
    owner, token = await signed_in(client)
    headers = bearer(token)
    item = (
        await client.post(f"/users/{owner['pid']}/items", json={"name": "Engine"}, headers=headers)
    ).json()
    path = f"/users/{owner['pid']}/items/{item['pid']}"

    assert (await client.delete(path, headers=headers)).status_code == 204
    assert (await client.get(path, headers=headers)).status_code == 404


async def test_deleting_an_owner_deletes_their_items(client: AsyncClient) -> None:
    """The foreign key cascades, so an item never outlives its owner."""
    owner, token = await signed_in(client)
    headers = bearer(token)
    item = (
        await client.post(f"/users/{owner['pid']}/items", json={"name": "Engine"}, headers=headers)
    ).json()

    await client.delete(f"/users/{owner['pid']}", headers=headers)

    administrator = await admin_bearer()
    gone = await client.get(f"/users/{owner['pid']}/items/{item['pid']}", headers=administrator)
    assert gone.status_code == 404


async def test_a_deleted_owners_token_stops_working(client: AsyncClient) -> None:
    """Deleting an account revokes its tokens, so the caller cannot read on.

    Without this the previous test's cleanup would prove nothing: a 404 from a
    dead credential looks the same as a 404 from a deleted row.
    """
    owner, token = await signed_in(client)

    await client.delete(f"/users/{owner['pid']}", headers=bearer(token))

    after = await client.get(f"/users/{owner['pid']}/items", headers=bearer(token))
    assert after.status_code == 401


async def test_a_stranger_gets_404_for_an_unknown_owner_and_403_for_a_real_one(
    client: AsyncClient,
) -> None:
    """The owner is resolved by pid first, then the policy runs; that is the design.

    Under primary keys the order was reversed, so a 404-versus-403 difference
    could not be used to probe which ids exist. A pid is random: a stranger
    holding one was given it, so the difference tells them nothing they did
    not have, and resolving first keeps every rule working on primary keys.
    """
    ada = await create_user(client, email="ada@example.com")
    _, stranger = await signed_in(client, email="mallory@example.com")

    unknown = await client.post(
        f"/users/{MISSING_ID}/items", json={"name": "Orphan"}, headers=bearer(stranger)
    )
    real = await client.post(
        f"/users/{ada['pid']}/items", json={"name": "Not yours"}, headers=bearer(stranger)
    )

    assert unknown.status_code == 404
    assert real.status_code == 403
