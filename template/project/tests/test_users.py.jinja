async def test_the_password_is_never_returned(
    client: AsyncClient, user_payload: dict[str, str]
) -> None:
    """The reason UserCreate and UserRead are separate classes."""
    body = (await client.post("/users", json=user_payload)).json()

    assert "password" not in body
    assert "hashed_password" not in body
    assert user_payload["password"] not in str(body)


async def test_a_duplicate_email_is_a_conflict(
    client: AsyncClient, user_payload: dict[str, str]
) -> None:
    await client.post("/users", json=user_payload)

    response = await client.post("/users", json=user_payload)

    assert response.status_code == 409
    assert response.headers["content-type"].startswith("application/problem+json")
    problem = response.json()
    assert problem["title"] == "Conflict"
    assert problem["status"] == 409
    assert "ada@example.com" in problem["detail"]
    assert problem["instance"] == "/users"


async def test_a_short_password_is_rejected(
    client: AsyncClient, user_payload: dict[str, str]
) -> None:
    response = await client.post("/users", json={**user_payload, "password": "short"})

    assert response.status_code == 422
    assert response.headers["content-type"].startswith("application/problem+json")
    assert response.json()["errors"]


async def test_fetching_a_user(client: AsyncClient) -> None:
    created, token = await signed_in(client)

    response = await client.get(f"/users/{created['pid']}", headers=bearer(token))

    assert response.status_code == 200
    assert response.json() == created


async def test_fetching_an_unknown_user_is_a_problem_document(client: AsyncClient) -> None:
    token = (await signed_in(client))[1]

    response = await client.get(f"/users/{MISSING_ID}", headers=bearer(token))

    assert response.status_code == 404
    problem = response.json()
    assert problem["status"] == 404
    assert problem["type"].endswith("/not-found")
    assert MISSING_ID in problem["detail"]


async def test_listing_users(client: AsyncClient) -> None:
    """Asserted as a set: every row in one test shares a transaction timestamp."""
    await create_user(client, email="ada@example.com")
    await create_user(client, email="grace@example.com")

    response = await client.get("/users", headers=await admin_bearer())

    assert response.status_code == 200
    emails = {user["email"] for user in response.json()}
    assert {"ada@example.com", "grace@example.com"} <= emails


async def test_listing_users_respects_the_page_size(client: AsyncClient) -> None:
    await create_user(client, email="ada@example.com")
    await create_user(client, email="grace@example.com")

    response = await client.get("/users", params={"limit": 1}, headers=await admin_bearer())

    assert len(response.json()) == 1


async def test_listing_users_needs_an_administrator(client: AsyncClient) -> None:
    """A listing of every address is the enumeration the sign-in path refuses to give."""
    token = (await signed_in(client))[1]

    assert (await client.get("/users", headers=bearer(token))).status_code == 403


async def test_another_users_account_is_not_readable(client: AsyncClient) -> None:
    created = await create_user(client, email="ada@example.com")
    stranger = (await signed_in(client, email="grace@example.com"))[1]

    path = f"/users/{created['pid']}"
    assert (await client.get(path, headers=bearer(stranger))).status_code == 403
    assert (await client.get(path, headers=await admin_bearer())).status_code == 200


async def test_no_response_carries_a_primary_key(client: AsyncClient) -> None:
    """The pid is the only identifier on the wire; the primary key never leaves the process."""
    created, token = await signed_in(client)

    fetched = (await client.get(f"/users/{created['pid']}", headers=bearer(token))).json()
    listed = (await client.get("/users", headers=await admin_bearer())).json()

    assert "id" not in created and "id" not in fetched
    assert all("id" not in user for user in listed)
    assert created["pid"] == fetched["pid"]


async def test_reading_users_requires_a_caller(client: AsyncClient) -> None:
    """`GET /users` is the address book the sign-in path spends 40ms hiding.

    Argon2 against a dummy hash, a uniform 401 and one message for both failures
    are all defences against enumerating who has an account here. An open
    listing answers the same question as JSON, in one request, for everybody.
    """
    created = await create_user(client)

    assert (await client.get("/users")).status_code == 401
    assert (await client.get(f"/users/{created['pid']}")).status_code == 401


async def test_updating_a_user(client: AsyncClient) -> None:
    created, token = await signed_in(client)

    response = await client.patch(
        f"/users/{created['pid']}", json={"full_name": "Augusta Ada King"}, headers=bearer(token)
    )

    assert response.status_code == 200
    body = response.json()
    assert body["full_name"] == "Augusta Ada King"
    assert body["email"] == created["email"], "an unset field must be left alone"


async def test_a_partial_update_cannot_carry_a_password(client: AsyncClient) -> None:
    """`password` is not a field on UserUpdate, and extra keys are ignored.

    Belt and braces for the takeover this route used to allow: even sent by the
    account's owner, the value must not reach the column — a password change
    goes through the route that demands the current one.
    """
    created, token = await signed_in(client)

    response = await client.patch(
        f"/users/{created['pid']}", json={"password": "a-different-password"}, headers=bearer(token)
    )

    assert response.status_code == 200
    assert "password" not in response.json()
    replaced = await client.post(
        "/sessions", json={"email": created["email"], "password": "a-different-password"}
    )
    assert replaced.status_code == 401, "PATCH set a password"


async def test_updating_to_a_taken_email_is_a_conflict(client: AsyncClient) -> None:
    await create_user(client, email="ada@example.com")
    other, token = await signed_in(client, email="grace@example.com")

    response = await client.patch(
        f"/users/{other['pid']}", json={"email": "ada@example.com"}, headers=bearer(token)
    )

    assert response.status_code == 409


async def test_updating_an_unknown_user_is_not_found(client: AsyncClient) -> None:
    """404 for a pid nobody has: a pid is random, so there is no registry to probe.

    Under primary keys the policy ran first and answered 403, because a
    404-versus-403 difference would have been a free oracle for which ids
    exist. With a random public identifier there is nothing to enumerate, and
    resolving the row first lets every rule keep working on primary keys.
    """
    token = (await signed_in(client))[1]

    response = await client.patch(
        f"/users/{MISSING_ID}", json={"full_name": "Nobody"}, headers=bearer(token)
    )

    assert response.status_code == 404


async def test_deleting_a_user(client: AsyncClient) -> None:
    """Asserted through a second caller: deleting revokes the deleted user's tokens."""
    created, token = await signed_in(client, email="ada@example.com")
    observer = (await signed_in(client, email="grace@example.com"))[1]

    deleted = await client.delete(f"/users/{created['pid']}", headers=bearer(token))
    gone = await client.get(f"/users/{created['pid']}", headers=bearer(observer))

    assert deleted.status_code == 204
    assert gone.status_code == 404


async def test_a_caller_cannot_modify_another_users_account(client: AsyncClient) -> None:
    """The takeover this scaffold used to ship, asserted from the attacker's side.

    Read an address from the listing, PATCH a password onto it, sign in as them.
    Every step below is one an unauthenticated request could once complete.
    """
    victim = (await signed_in(client, email="ada@example.com"))[0]
    attacker = (await signed_in(client, email="mallory@example.com"))[1]
    headers = bearer(attacker)

    disabled = await client.patch(
        f"/users/{victim['pid']}", json={"is_active": False}, headers=headers
    )
    repassworded = await client.put(
        f"/users/{victim['pid']}/password",
        json={"current_password": "irrelevant", "new_password": "attacker-chosen"},
        headers=headers,
    )
    removed = await client.delete(f"/users/{victim['pid']}", headers=headers)
    victim_signs_in = await client.post(
        "/sessions", json={"email": "ada@example.com", "password": DEFAULT_USER["password"]}
    )

    assert disabled.status_code == 403
    assert repassworded.status_code == 403
    assert removed.status_code == 403
    assert victim_signs_in.status_code == 201, "the attacker changed something"


async def test_a_write_without_a_caller_is_refused(client: AsyncClient) -> None:
    """Anonymously: no PATCH, no password, no DELETE. 401, before ownership."""
    created = await create_user(client)

    disabled = await client.patch(f"/users/{created['pid']}", json={"is_active": False})
    repassworded = await client.put(
        f"/users/{created['pid']}/password",
        json={"current_password": "x", "new_password": "attacker-chosen"},
    )
    removed = await client.delete(f"/users/{created['pid']}")

    assert disabled.status_code == 401
    assert repassworded.status_code == 401
    assert removed.status_code == 401


async def test_changing_a_password_requires_the_caller(client: AsyncClient) -> None:
    """No token, no password change — and the old one still signs in afterwards."""
    created = await create_user(client)

    response = await client.put(
        f"/users/{created['pid']}/password",
        json={"current_password": DEFAULT_USER["password"], "new_password": "attacker-chosen"},
    )

    assert response.status_code == 401
    assert response.headers["www-authenticate"] == "Bearer"
    unchanged = await client.post(
        "/sessions", json={"email": created["email"], "password": DEFAULT_USER["password"]}
    )
    assert unchanged.status_code == 201


async def test_changing_a_password_requires_the_current_one(client: AsyncClient) -> None:
    """A bearer token can be stolen; the password in force is what a thief lacks.

    403 rather than 401: the token presented was accepted, and answering a
    working credential with a challenge signs the caller out over a typo.
    """
    created, token = await signed_in(client)

    response = await client.put(
        f"/users/{created['pid']}/password",
        json={"current_password": "not-the-one", "new_password": "a-new-password"},
        headers=bearer(token),
    )

    assert response.status_code == 403
    assert response.json()["type"].endswith("/forbidden")
    unchanged = await client.post(
        "/sessions", json={"email": created["email"], "password": DEFAULT_USER["password"]}
    )
    assert unchanged.status_code == 201


async def test_changing_a_password_replaces_it(client: AsyncClient) -> None:
    created, token = await signed_in(client)

    response = await client.put(
        f"/users/{created['pid']}/password",
        json={"current_password": DEFAULT_USER["password"], "new_password": "a-new-password"},
        headers=bearer(token),
    )

    assert response.status_code == 204
    assert not response.content, "the new password must not be echoed back"
    with_old = await client.post(
        "/sessions", json={"email": created["email"], "password": DEFAULT_USER["password"]}
    )
    assert with_old.status_code == 401
    with_new = await client.post(
        "/sessions", json={"email": created["email"], "password": "a-new-password"}
    )
    assert with_new.status_code == 201


async def test_ownership_cannot_be_smuggled_through_the_query_string(client: AsyncClient) -> None:
    """The hazard the previous mechanism needed a pinned `Path()` to survive.

    A dependency taking a scalar named `user_id` was sourced from the **query
    string** on any route whose path did not declare it — so a route spelled
    `/accounts/{id}` would have let a caller pass `?user_id=<their own>` and
    clear the check against somebody else's record. The rule now takes the id
    the service was called with, which is the path parameter, so a second value
    in the query has nothing to bind to.
    """
    victim = (await signed_in(client, email="ada@example.com"))[0]
    attacker, attacker_token = await signed_in(client, email="mallory@example.com")

    response = await client.patch(
        f"/users/{victim['pid']}",
        params={"user_id": attacker["pid"]},
        json={"full_name": "Owned"},
        headers=bearer(attacker_token),
    )

    assert response.status_code == 403


async def test_an_admin_may_change_an_account_but_not_its_password(client: AsyncClient) -> None:
    """One role, two answers — which is what the action parameter buys.

    `update` and `delete` fall to an administrator; `change-password` does not,
    because that route's precondition is the password in force and a role is not
    knowledge of it. Expressing this at all was impossible while ownership was a
    comparison between a path parameter and the caller.
    """
    victim = (await signed_in(client, email="ada@example.com"))[0]
    administrator = await admin_bearer()

    renamed = await client.patch(
        f"/users/{victim['pid']}", json={"full_name": "Renamed by support"}, headers=administrator
    )
    repassworded = await client.put(
        f"/users/{victim['pid']}/password",
        json={"current_password": "irrelevant", "new_password": "chosen-by-support"},
        headers=administrator,
    )

    assert renamed.status_code == 200
    assert renamed.json()["full_name"] == "Renamed by support"
    assert repassworded.status_code == 403
    still_theirs = await client.post(
        "/sessions", json={"email": "ada@example.com", "password": DEFAULT_USER["password"]}
    )
    assert still_theirs.status_code == 201, "an admin replaced somebody's password"


async def test_a_rehash_on_login_cannot_overwrite_a_newer_password(
    client: AsyncClient,
) -> None:
    """A sign-in hashes outside its transaction, so the row can move underneath.

    Rehash-on-login writes a hash of the password it was given, computed ~40ms
    earlier. A blind write reverts a password change committed during that
    window — the owner sees 204 and their sessions revoked, while the old
    password keeps working. The write is a compare-and-set for that reason.
    """
    user = await create_user(client, email="racer@example.com")
    pid = UUID(user["pid"])

    async with uow() as session:
        users = UserRepository(session)
        row = await users.get_by_pid(pid)
        assert row is not None
        current = row.hashed_password
        await users.update(row, {"hashed_password": "changed-by-somebody-else"})

    async with uow() as session:
        swapped = await UserRepository(session).replace_hash_if_unchanged(
            row.id, expected=current, new="the-stale-rehash"
        )

    assert not swapped, "a stale rehash overwrote a newer password"


async def test_a_stranger_who_knows_the_password_still_cannot_replace_it(
    client: AsyncClient,
) -> None:
    """The policy has to refuse, not the wrong-password check.

    Every other non-owner test on this route sends a deliberately wrong
    `current_password`, and that path answers 403 too — so deleting the
    `authorize` call left the whole suite green while a stranger who knew the
    password could take the account. This one sends the *correct* password.
    """
    victim, _ = await signed_in(client, email="victim@example.com")
    _, token = await signed_in(client)

    response = await client.put(
        f"/users/{victim['pid']}/password",
        json={
            "current_password": DEFAULT_USER["password"],
            "new_password": "attacker-chosen-value",
        },
        headers=bearer(token),
    )

    assert response.status_code == 403
    assert response.json()["detail"] == "you may not change-password this resource"

    still_theirs = await client.post(
        "/sessions",
        json={"email": "victim@example.com", "password": DEFAULT_USER["password"]},
    )
    assert still_theirs.status_code == 201, "the stranger replaced the password"


async def test_an_admin_is_refused_the_password_route_by_the_policy(
    client: AsyncClient,
) -> None:
    """Asserting the status alone cannot tell which check refused.

    A wrong current password is also a 403, so `assert status == 403` passes
    whether the policy ran or not. The detail is what distinguishes them.
    """
    victim, _ = await signed_in(client, email="victim@example.com")

    response = await client.put(
        f"/users/{victim['pid']}/password",
        json={"current_password": DEFAULT_USER["password"], "new_password": "whatever-1"},
        headers=await admin_bearer(),
    )

    assert response.status_code == 403
    assert response.json()["detail"] == "you may not change-password this resource"
